# Ignore node_modules (we install fresh in the container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore build output (we build fresh in the container)
dist
build

# Ignore development files
.env
.env.*
.env.local
.env.development
.env.production

# Ignore test files and coverage
coverage
.nyc_output
*.test.js
*.test.jsx
*.spec.js
*.spec.jsx
__tests__
e2e

# Ignore git
.git
.gitignore

# Ignore IDE
.vscode
.idea
*.swp
*.swo

# Ignore documentation
README.md
*.md
docs

# Ignore Docker files
Dockerfile
.dockerignore
docker-compose*.yml

# Ignore linting and formatting
.eslintrc*
.prettierrc*
.editorconfig

# Ignore misc
.DS_Store
*.log
