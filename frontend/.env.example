# Auth Service API Base URL (default: /api/users - uses Vite proxy in dev)
VITE_API_BASE_URL=/api/users

# Chat Service API Base URL (default: /api/chat - uses Vite proxy in dev)
# In production, use full URL: http://your-chat-service.com/api/chat
VITE_CHAT_API_URL=/api/chat

# Auth Token (optional)
VITE_AUTH_TOKEN=

# Avatar Video Interface URL
VITE_AVATAR_VIDEO_URL=https://example.invalid
