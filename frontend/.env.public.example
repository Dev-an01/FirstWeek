# Vercel server environment variables (never add VITE_ to secrets).
FIRSTWEEK_PUBLIC_ORIGIN=https://your-project.vercel.app
# false = source excerpts; true = OpenAI with bounded fallbacks.
FIRSTWEEK_PUBLIC_GENERATE=true
OPENAI_API_KEY=
FIRSTWEEK_PUBLIC_OPENAI_MODEL=gpt-5.6-luna
GROQ_API_KEY=
# Exact opt-in; false or unset skips Groq.
FIRSTWEEK_PUBLIC_GROQ_FALLBACK=true
FIRSTWEEK_PUBLIC_GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
# Must be openrouter/free or another model whose ID ends in :free.
FIRSTWEEK_PUBLIC_OPENROUTER_MODEL=openrouter/free
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
FIRSTWEEK_PUBLIC_RATE_SECRET=
FIRSTWEEK_PUBLIC_IP_DAILY_LIMIT=10
FIRSTWEEK_PUBLIC_GLOBAL_DAILY_LIMIT=30
# Persistent paid OpenAI-attempt cap. Delete fw-public:openai:total to reset deliberately.
FIRSTWEEK_PUBLIC_OPENAI_TOTAL_LIMIT=100
