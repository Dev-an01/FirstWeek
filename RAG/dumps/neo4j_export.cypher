 -0.0093380865, 0.02836286, 0.06504611, -0.038404, -0.036783963, -0.002084918, 0.0003150142, -0.0057790745, -6.0059063e-33, 0.00853653, -0.056490533, 0.007793671, -0.0028314367, -0.06589602, 0.03306302, 0.00491422, -0.025162602, -0.016695773, -0.016028512, -0.0073634717, -0.0047836, 0.01453082, 0.0143612735, 0.08043853, 0.0050858078, 0.016054206, 0.019196305, -0.04641475, -0.038263656, -0.02977101, 0.016963437, 0.001562649, -0.035085127, -0.04354644, 0.03401486, 0.00058149855, 0.03502485, -0.057900548, 0.0006518779, 0.056235746, 0.011910346, 0.01049596, -0.055402417, 0.002072544, 0.02626561, -0.013336199, 0.023039792, -0.0014389323, -0.04145446, 0.014700675, 0.029168889, 0.03201397, 0.027633522, 0.011139302, -0.005087254, -0.04641811, -0.016439695, -0.023185067, 0.019852452, -0.017499486, 0.05034629, -0.032198783, 0.041563902, -0.023059698, 0.047409732, -0.01166424, 0.065687865, -0.035514545, -0.011786035, -0.024930187, -0.06272292, 0.051282533, 0.051562898, -0.015218934, -0.00032677007, -0.022422837, 0.028252507, 0.031080874, 0.020306196, -0.013944486, 0.049594764, -0.023978062, 0.0014364248, -0.018611774, -0.01954091, 0.019321531, 0.011966187, 0.017818987, 0.01537734, -0.026796203, -0.010481199, -0.050636332, -0.04208732, 0.053259138, 0.0029708818, -0.0025135651, 0.010703506, 0.036864363, 0.0012708337, -0.014107106, 0.01931811, 0.00021886203, 0.030232493, 0.009887831, -0.036504194, 0.027892435, 0.014087351, -0.017681206, -0.028421173, 0.011704421, 0.006204812, 0.05047651, 0.016445667, -0.011621792, -0.006780625, -0.029319908, -0.06025524, 0.016657004, 0.0215867, 0.038811672, 0.010407164, -0.0026294882, 0.004752006, -0.012696626, 0.010801958, 0.0053785522, -0.035432763, 0.010649225, 0.015340826, 0.009836546, -0.025408657, -0.018060118, -0.052924335, 0.01721557, 0.0177099, 0.042288452, -0.0034275488, -0.018758774, -0.05051496, -0.0042458195, -0.044331413, 3.1553398e-07, 0.041003615, -0.023592088, -0.052018907, 0.051240202, -0.018718587, 0.04163297, -0.05407967, 0.009205194, 0.084733844, -0.009978119, 0.11261097, -0.054538507, -0.07179825, 0.048714664, 0.04115704, -0.068755105, 0.021890864, -0.06163158, -0.039630983, 0.014485824, 0.035018686, 0.008925411, 0.006434489, -0.030616863, 0.0338989, 0.0048718983, -0.007002277, -0.022961894, 0.0002319125, 0.023360722, 0.09118754, -0.08351165, -0.0098510245, 9.664827e-05, -0.011662725, 0.0024745304, -0.03241729, -0.02014024, 0.033349995, -0.037195485, 0.0009849363, -0.037925877, 0.041729674, 0.026049705, 0.027435293, -0.042966038, -0.020568471, 0.0004748685, -0.04110992, -0.03472256, 0.03787261, 0.042417377, -0.024667539, 0.021406222, -0.012026285, 0.02902349, 0.024222912, 0.026759498, 0.06387529, 0.06658335, -0.020911254, -0.01794984, 0.012245825, 0.017967226, 0.023166448, 0.009096031, -0.032289572, 3.1080796e-34, 0.021854196, -0.054645658, 0.06132243, -0.04055898, -0.020365203, 0.0026477752, 0.0058709476, 0.0017446579, 0.011147924, 0.0007119818, -0.018594438], embedding_text: "Decision Case: Untitled Decision\nDecision ID: exec_004_test_DEC_003\nExecutive: exec_004_test\nCategory: marketing_sales_alignment\nDate: 2024-06-15\n\nSituation:\nTension escalating between marketing and sales teams. Quarterly sales review meeting turned contentious: Sales VP: 'Marketing is generating garbage leads. MQL volume is up 40% but only 12% convert to opportunities. We're wasting time on low-quality leads.' VP's data showed: 1200 MQLs in Q2, only 144 converted to sales opportunities (12% conversion), 88% of MQLs never responded to sales outreach. Sales team frustrated: 'Half these MQLs are students downloading whitepapers, tire-kickers, competitors researching us, not real buyers.' My marketing team defensive: 'We hit our MQL target (1200). Sales isn't following up fast enough. Their response time is 18 hours, should be <2 hours. They're not nurturing properly.' Both teams pointing fingers. The data revealed deeper problem: (1) Our MQL definition was broad: 'Downloaded 2 pieces of content OR attended 1 webinar OR visited pricing page 3x.' This was too loose - activity doesn't mean buying intent. (2) Marketing KPI: MQL volume (rewarded for quantity). Sales KPI: Closed deals (rewarded for quality). Misaligned incentives. (3) No feedback loop: Marketing didn't know which MQL sources produced customers. Sales didn't tell marketing which leads were good/bad. (4) Hand-off process broken: Marketing dumps leads in Salesforce, sales picks up when they can, no SLA. (5) Lead scoring: We had 50+ lead score factors but it was overfitted and ignored by sales. Real issue: We optimized for activity metrics (MQL volume) not business metrics (revenue pipeline). CEO Akiko pulled me aside: 'Sarah, this is affecting company culture. Marketing and sales are supposed to be one revenue team, not rivals. Fix this.' CFO Raj added cost perspective: 'We're spending ¥22M per quarter on marketing for 1200 MQLs. That's ¥18K per MQL. If only 12% are quality, real cost is ¥150K per good lead. That's insane.' I had to choose: defend marketing metrics (we hit our MQL target!) or admit the system is broken and rebuild partnership with sales.\n\nDecision Made:\nOption 4 - Comprehensive realignment with public ownership of marketing's mistakes: (1) Immediate Actions (Week 1): I apologized to sales team in joint all-hands: 'Sales team is right. We've been optimizing for MQL volume, not revenue. That's my fault as CMO. We're fixing this together.' Announced joint task force (3 marketing + 3 sales) to redesign lead management. (2) New MQL Definition (Intent-Based): OLD: Downloaded 2 content pieces OR webinar attendance OR pricing visits. NEW: 'Sales-Ready Lead' (SRL) requires BANT qualification (Budget, Authority, Need, Timeline) + engagement. Specific criteria: Works at target company size (100+ employees), Job title indicates decision influence, Downloaded bottom-funnel content (ROI calc, comparison guide) OR demo request, Visited pricing 5+ times in 7 days OR watched product video. (3) New Marketing KPIs (Revenue-Focused): OLD KPIs: MQL volume, Content downloads, Website traffic. NEW KPIs: SRLs generated (not MQLs), SRL→Opportunity conversion (target 35%+), Pipeline generated ($$), Revenue influenced. Basically: Own pipeline, not activity. (4) Bi-Directional SLAs: Marketing SLA: Deliver 400 SRLs/quarter (vs 1200 MQLs) with 35%+ conversion. Sales SLA: Contact SRLs within 2 hours, Provide weekly feedback on lead quality, Update lead status within 48 hours. (5) Feedback Loop: Weekly marketing-sales sync reviewing lead quality, Monthly closed-loop analysis (which campaigns drove customers?), Quarterly joint planning. (6) Lead Handoff Process: Marketing nurtures leads to SRL threshold, Sales accepts/rejects SRL within 4 hours with reason, Rejected leads return to marketing nurture (not black hole). (7) Simplified Lead Scoring: Reduced from 50 factors to 8 high-signal indicators, Sales team helped design scoring (they trust it now). (8) Cultural Shift: Renamed to 'Revenue Team' (marketing + sales), Shared revenue target, Joint team celebration when company hits number.\n\nRationale:\nThis required swallowing my pride and admitting marketing was optimizing for wrong metrics. Here's my thinking: (1) Sales Team is Right - 88% low-quality MQLs is damning data. I was defensive because hitting MQL targets, but that's vanity metric. What matters is revenue pipeline. If sales is wasting 88% of their time on junk leads, that's marketing failure, not sales execution. (2) MQL Volume is Vanity Metric - We celebrated 1200 MQLs but real cost per quality lead was ¥150K. That's unsustainable. Better to generate 400 quality leads (SRLs) at ¥55K each than 1200 garbage leads at ¥150K per quality. Math is obvious. (3) Root Cause is Misaligned Incentives - Marketing rewarded for MQL volume incentivizes quantity over quality. Sales rewarded for closed deals incentivizes ignoring marketing leads. System designed for conflict. Need shared revenue accountability. (4) Intent Matters More Than Activity - Downloading whitepaper doesn't mean buying intent. Watching product demo + visiting pricing 5x + right job title = intent signal. New SRL definition focuses on buying signals not activity. (5) Feedback Loop is Critical - Marketing has been operating blind. We don't know which campaigns drive customers. Sales knows but doesn't tell us. Closed-loop analysis (which SRLs became customers?) lets us optimize. This is Marketing 101 we somehow forgot. (6) Public Apology Builds Trust - I could have defended marketing privately while fixing things. But I apologized publicly to sales team: 'You're right, we screwed up.' This signaled humility and genuine change. Sales team's body language shifted from hostile to collaborative. (7) Shared KPIs Create Partnership - When marketing owns MQL volume and sales owns revenue, we fight. When both own pipeline and revenue, we collaborate. New KPIs make us one team. This honors Marketing-Sales Partnership (literally fixing broken partnership), Customer-Centric Marketing (quality leads serve customers better), and Data-Driven Creativity (using conversion data to redesign system). Hardest part: Admitting marketing's MQL obsession was wrong. But CEO Akiko: 'Sarah, this took courage. Respect.' CFO Raj: 'This is the kind of accountability I want to see.'\n\nOutcome:\nTRANSFORMATIONAL SUCCESS - Four months later: (1) Lead quality: SRL→Opportunity conversion: 12% → 38% (217% improvement). Sales team: 'These leads are night and day different.' (2) Lead volume: MQL volume dropped from 1200 to 380 SRLs (68% decrease) BUT quality so much higher it nets more pipeline. (3) Sales efficiency: Sales reps spending 82% of time on quality leads (vs 12% before). SDR productivity up 3x. (4) CAC efficiency: Cost per quality lead: ¥150K → ¥58K (61% improvement). Marketing spend per SRL: ¥18K (better economics). (5) Pipeline generated: Q2: ¥180M pipeline from marketing. Q3: ¥ 310M pipeline from marketing (72% increase despite fewer leads). (6) Revenue impact: Closed-won revenue attributed to marketing: +65% in Q3 vs Q2. (7) SLA compliance: Marketing hit 35%+ SRL conversion (achieved 38%). Sales response time: 18 hours → 1.8 hours (10x improvement). (8) Feedback loop: Weekly marketing-sales syncs now productive collaboration, not blame sessions. Sales provides qual itative feedback: 'Campaign X drove great leads, do more.' (9) Cultural transformation: Joint all-hands celebration when company hit Q3 revenue target. Marketing and sales teams high-fiving, not fighting. 'Revenue Team' mentality took root. (10) Lead scoring: New 8-factor scoring adopted by sales. Sales reps now trust and use it (was ignored before). (11) CFO Raj: 'This is best marketing efficiency improvement I've seen. ¥58K per quality lead vs ¥150K. That's how you think financially.' (12) Sales VP became my biggest ally: 'Sarah fixed this. She admitted we were right, rebuilt the system, and it works. That's leadership.' (13) CEO Akiko featured this transformation in board presentation as example of 'cross-functional excellence.' (14) Employee engagement: Marketing team initially scared of lower MQL targets but now love working on quality over quantity. Morale improved. (15) External recognition: Asked to speak at SaaStr conference on 'Marketing-Sales Alignment' - 500+ attendees.\n\nLessons Learned:\nVanity metrics (MQL volume) destroy companies - focus on business metrics (pipeline, revenue). Public apology and ownership accelerates trust rebuilding - I could have fixed this quietly but public apology changed dynamic. Misaligned incentives create conflict - shared KPIs (revenue/pipeline) create collaboration. Sales team is usually right about lead quality - listen to them. Intent signals (demo requests, pricing visits) matter more than activity (content downloads). Fewer high-quality leads outperform many low-quality leads - 380 SRLs at 38% conversion beats 1200 MQLs at 12% conversion. Feedback loops are critical - closed-loop analysis (which leads became customers) lets marketing optimize. SLAs work when bi-directional - holding both sides accountable. Cultural shift ('Revenue Team') reinforces behavioral change. This required humility - admitting 'we were optimizing for wrong thing' was hard but necessary. CFO appreciated financial thinking (¥58K vs ¥150K per quality lead). Sales VP went from adversary to champion. Best validation: Marketing and sales teams now collaborate naturally, not because forced. Wish I'd listened to sales complaints 6 months earlier instead of being defensive.\n\nConfidence: 0.84\nPrecedent: No", category: 'technical_debt', decision_made: 'Prioritized modernizing 6-year-old admin panel after security incident', outcome: 'IN_PROGRESS'});
CREATE (n24:Company {arr: 3900000.0, size: 'Mid-Market', customer_since: '2023-07-22', name: 'MediaHouse Tokyo', description: 'Digital media company', industry: 'Media', id: 'company_mediahouse', type: 'customer', region: 'Japan', relationship: 'Active Customer'});
CREATE (n25:Decision {date: neo4j.time.Date(2024, 5, 15), executive_id: 'exec_003_test', confidence: 0.92, embedding_model: 'sentence-transformers/all-mpnet-base-v2', executive_name: 'Yuki Nakamura', title: '6-Week Technical Debt Sprint', financial_impact: 75000000.0, embedding_date: neo4j.time.DateTime(2025, 10, 24, 4, 45, 3, 120000000, tzinfo=<UTC>), rationale_summary: 'Velocity declined 40% due to accumulated debt. 6 weeks investment to gain 36% velocity improvement. ROI: 2.3x.', embedding_dimensions: 768, precedent: True, lessons_learned: 'Technical debt is real debt. Pay it proactively on your terms.', id: 'exec_003_test_DEC_004', embedding: [0.0600998, 0.057115022, 0.009327783, -0.049298637, -0.03542459, -0.0007464717, -0.04162187, 0.021448536, -0.0872261, -0.056354586, -0.021561751, 0.07523703, -0.020545628, 0.082875706, -0.06765478, 0.04604287, -0.010252954, 0.010619005, 0.016220257, 0.004369876, 0.045830317, -0.0051857703, 0.038762912, -0.02851929, 0.010535424, 0.00035327364, 0.036182452, -0.006817166, -0.031632643, -0.06885479, 0.0065196804, 0.059801746, -0.009688491, 0.012923932, 2.1970802e-06, -0.022826152, -0.037713062, -0.013403549, 0.017032174, 0.06952763, 0.034379248, 0.03693442, -0.016410226, 0.007982811, -0.034661863, 0.050389495, -0.020325223, 0.013605905, 0.0075847893, 0.036741875, -0.008905615, 0.0059735654, -0.06174556, 0.0030465913, -0.069074675, -0.038737755, -0.00015762623, 0.019076306, 0.026076254, -0.016401695, -0.03837164, 0.064279154, -0.050918113, -0.06350938, 0.014988302, 0.054274727, 0.06248357, -0.0029047257, 0.0068856818, -0.047666688, -0.0040959595, 0.008177808, 0.026425784, -0.0021300893, 0.025368642, -0.05702242, 0.012291006, -0.018172389, 0.022487776, 0.031553827, -0.010604488, 0.021545783, -0.020148572, 0.006117944, -0.007829583, -0.0044383244, -0.02325731, -0.037960593, 0.042633567, 0.039208338, 0.15592846, -0.059477374, -0.011689228, -0.026548382, 0.0045041544, 0.006724349, 0.096376084, 0.028175602, -0.01820695, -0.049383566,