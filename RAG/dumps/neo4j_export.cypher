500454, -0.03238431, -0.0051692952, 0.046336904, 0.061806325, 0.032487184, -0.028771523, -0.029892784, -0.025168154, 0.034644827, -5.9503495e-33, 0.056986034, -0.06401219, -0.025420947, 0.026396645, -0.024686942, 0.0444169, -0.016121171, -1.8186227e-05, -0.015232775, -0.007720278, -0.042107325, 0.009265028, 0.034449425, 0.01773968, 0.058695458, -0.03252479, 0.015376695, 0.01081911, 0.0005956759, -0.0019025392, 0.018017093, -0.0010022636, 0.01104157, -0.04081819, -0.011413493, 0.033862572, -0.014869324, 0.037678834, -0.054379713, -0.013365272, 0.024567276, 0.037463237, 0.008982582, -0.08194833, 0.041244898, 0.016268091, -0.021553196, 0.008580896, 0.0109225055, -0.052496854, 0.01083668, 0.019125486, 0.046125416, 0.032240547, 0.012321146, -0.016407026, 0.012539553, -0.00805535, -0.02060307, -0.012688891, -0.03829601, 0.024180226, -0.048546743, 0.071509115, -0.047470823, -0.03156733, -0.02069378, 0.06358297, -0.10911602, -0.0062530376, -0.040562484, -0.05036669, 0.012695946, 0.004124307, -0.0036326055, 0.016139515, -0.025561439, 0.051051892, 0.0037993435, -0.008151959, -0.036250688, 0.045368064, -0.049544826, 0.007433722, 0.0057680625, -0.09068124, -0.014496067, 0.04132737, 0.06081429, 0.02325614, -0.013037771, -0.011875222, -0.029388342, -0.0059485096, 0.061127733, -0.025469655, -0.05065717, -0.03302017, -0.0064914576, 0.023366248, -0.0037270836, 0.04303947, 0.008135351, 0.014254892, -0.049696274, -0.055535737, 0.05350115, 0.02882055, 0.023631563, -0.024847172, 0.0027061629, -0.0123497825, -0.013738531, 0.008601096, -0.0045502274, -0.05797054, -0.010779489, -0.0017197448, 0.017893583, 0.043982446, 0.044692703, -0.0074200416, -0.025432875, -0.009004987, -0.029981252, 0.044010967, 0.01590399, -0.04112215, 0.030626874, 0.099602595, 0.0123884715, 0.0015102956, -0.012958968, -0.054902982, -0.020455634, 0.046262953, 0.052682765, 0.008050355, -0.0046675373, -0.042100534, 0.008610134, -0.032198925, 2.753661e-07, 0.015987605, -0.034553885, -0.049564086, -0.025155304, 0.015479721, 0.03502191, 0.007225777, 0.013149425, 0.062333714, -0.047887564, 0.0716722, -0.057144523, -0.049962644, 0.020742862, -0.015679551, -0.039008383, 0.023356834, -0.03016911, -0.042545356, -0.015608624, 0.08890865, -0.0061500566, -0.009339033, -0.020649051, -0.018931622, 0.05059612, 0.04051737, -0.019864228, -0.016361933, -0.0027164666, 0.033810686, -0.04872729, -0.032990135, -0.074386634, -0.011351149, 0.041417483, -0.024460366, 0.02835897, 0.044964783, -0.0031656814, 0.03160845, -0.026465114, 0.04307429, 0.008805274, 0.0091497, -0.034323156, -0.05215914, -0.027100673, -0.062832184, -0.017917354, 0.0104848705, 0.04216076, -0.045029238, 0.019542295, -0.022433154, 0.02035788, 0.027757397, -0.022687204, 0.056389835, 0.06589999, -0.035464965, 0.031773187, 0.030545034, 0.0015705654, 0.044784155, 0.056532368, 0.029703824, 2.4858365e-34, 0.016443666, -0.06973519, 0.03797116, 0.0019156996, -0.030150793, 0.042485967, 0.0032295187, -0.02369865, -0.004956654, -0.0009273417, -0.0035597328], embedding_text: "Decision Case: Untitled Decision\nDecision ID: exec_004_test_DEC_005\nExecutive: exec_004_test\nCategory: brand_crisis\nDate: 2024-09-25\n\nSituation:\nFriday afternoon: Influencer on LinkedIn (85K followers, well-known in B2B SaaS community) posted harsh criticism of NexaTech: 'NexaTech's new pricing is a bait-and-switch. They lured us in with ¥85K Professional tier, now pushing us to ¥300K Enterprise tier for features that should be included. Classic SaaS upsell trap. Not cool.' Post went viral - 340 likes, 89 comments (mostly negative), 12 shares within 3 hours. Context: We had launched new pricing 2 months ago (part of mid-market push). Moved some advanced features (custom integrations, advanced analytics) from Professional to Enterprise tier to create clearer differentiation. This affected ~80 existing Professional customers who used those features - they were grandfathered for 12 months, then need to upgrade or lose features. We communicated this via email and in-app notification. But this influencer customer: (1) Missed our communication (claimed they never got email), (2) Discovered feature removal when trying to use it, (3) Felt blindsided, (4) Posted angry LinkedIn thread. Comments on post were piling up: 'This is why I don't trust SaaS companies.' 'Classic dark pattern.' 'NexaTech used to be good guys, disappointing.' Our competitors (WorkMax employees) were fanning flames in comments. Crisis escalating fast. By 5 PM Friday: 15 customer support tickets about pricing concerns, 3 customers threatened to churn, Internal Slack blowing up with 'have you seen this LinkedIn post?', Sales team worried about Monday prospects seeing this, CEO Akiko traveling (reachable but asked me to handle). I had to decide response strategy: (1) Ignore and let it blow over? (2) Reply defensively explaining our reasoning? (3) Reply empathetically and offer resolution? (4) Full public accountability and policy change? Comms team wanted cautious legal-approved response. Sales team wanted aggressive defense of pricing. My instinct: This is not about one customer, it's about trust. How we respond defines our brand. Pressure was high: Competitors using this against us, need to respond quickly before weekend amplifies it, but wrong response makes it worse, CEO's 'radical transparency' value in my mind.\n\nDecision Made:\nOption 4 - Full public accountability within 2 hours: (1) Immediate public response on LinkedIn (posted at 6:45 PM Friday as CMO, not PR team): '@[Influencer] - You're right to be frustrated. We made two mistakes: First, our communication about feature changes wasn't clear enough. If you missed it, others did too. That's on us. Second, 12-month grandfathering period is too short for customers to plan. We should have done better. Here's what we're doing: (1) Extending grandfathering to 24 months (from 12) for all 80 affected customers. (2) Offering permanent Professional-tier pricing with Enterprise features for customers who committed before the change. (3) Improving our communication - no more important changes via just email. (4) I'm personally calling all 80 affected customers next week to apologize and discuss their options. This is on me as CMO. We're not perfect, but we're committed to doing right by customers. Thank you for calling us out. - Sarah Kim, CMO' (2) Internal all-hands email (Friday 7 PM): Explained the situation, owned the mistake, announced policy changes, rallied team around customer-first response. (3) Weekend: Drafted customer communication plan for Monday. (4) Monday morning: Personal email from me to all 80 affected customers apologizing and offering extended grandfathering + permanent pricing option. (5) Week following: Personally called 80 customers (promised publicly, delivered). (6) Blog post: 'What We Learned from Our Pricing Communication Failure' - transparent post-mortem.\n\nRationale:\nThis required vulnerability and fast decision-making under pressure. Here's my thinking: (1) Trust Matters More Than Being Right - Yes, we sent communication. Yes, we grandfathered 12 months. Technically we did things 'right.' But customer felt blindsided. In trust vs technically-correct, trust wins every time. Better to admit 'we could have communicated better' than defend 'we sent email.' (2) Public Callout Requires Public Response - This is LinkedIn, not private complaint. 85K people watching. Silence or private resolution looks cowardly. Public accountability shows we're not hiding. Vulnerability builds trust. (3) One Customer is 80 Customers - Influencer was vocal, but 80 customers affected. If one missed communication, others did too. This is systemic problem, not one-off. Fix the system, not just the squeaky wheel. (4) Radical Transparency (CEO's Value) - Akiko's core value is radical transparency. WWAD (What Would Akiko Do)? She'd own the mistake publicly. That's our brand. Defensive response violates who we are. (5) Turn Crisis Into Trust - Admitting mistake and extending grandfathering 12→24 months shows we listen and act. Costs us ~¥8M (24 months revenue deferral) but buys immeasurable trust. Best PR is genuine accountability. (6) Speed Matters - Friday 5 PM crisis. I responded by 6:45 PM (under 2 hours). Fast response contains damage. Monday response would be too late - competitors control narrative all weekend. (7) Personal Commitment Creates Credibility - 'I'm personally calling all 80 customers' is vulnerable. Puts my credibility on line. But it's authentic. I called all 80 (took 2 weeks but did it). This honors Customer-Centric Marketing (customers over company ego), Brand Building Over Quick Wins (protect long-term trust over short-term revenue), and aligns with CEO's Radical Transparency value. Risk: Looks like we caved to public pressure. But better 'we listen to customers' than 'we ignore complaints.'\n\nOutcome:\nBETTER THAN EXPECTED - Two weeks later: (1) LinkedIn post: Influencer updated original post: 'UPDATE: NexaTech CMO responded within 2 hours, extended grandfathering to 24 months, and personally called me to apologize. This is how you handle mistakes. Respect.' Original negative comments turned positive: 'This is refreshing transparency.' 'Wish more SaaS companies responded like this.' Net sentiment: 76% positive after response (was 89% negative before). (2) Customer response: Of 80 affected customers, 78 stayed (only 2 churned, and those were already considering leaving). 45 took permanent Professional pricing with Enterprise features (¥85K with ¥300K features - generous but bought massive loyalty). 33 accepted 24-month grandfathering (time to evaluate). (3) Support tickets: 15 tickets closed positively. Zero escalations. (4) Sales impact: Opposite of feared - prospects mentioned response: 'I saw how you handled that LinkedIn situation. That's integrity.' Won 2 deals where decision-maker cited crisis response as trust factor. (5) Employee morale: Team proud of response. Marketing team: 'This is why I work here - we do right thing even when hard.' (6) Media coverage: Industry blog featured response as 'SaaS crisis management done right.' Got 8K views. (7) Competitor backfire: WorkMax employees who fanned flames looked petty when we responded gracefully. Our response made them look bad. (8) Financial cost: ¥8M revenue deferred (24-month grandfathering) but retention saved ¥96M ARR (78 customers × ¥1.2M average). Net positive ¥88M. (9) CEO Akiko: 'Sarah, you embodied our values under pressure. Perfect response. I couldn't have done it better.' (10) Board: Cited this case as example of 'brand stewardship' in quarterly review. (11) Policy improvements: Changed communication protocol - important changes now multi-channel (email + in-app + phone call for enterprise). (12) Long-term: That influencer became advocate, recommended us 3 times publicly in next 6 months. (13) Internal training: Used this case in employee onboarding as 'how we handle mistakes.' (14) Brand perception: Market research showed 'trustworthiness' score for NexaTech increased 12 points after incident (crisis became trust builder).\n\nLessons Learned:\nPublic accountability builds trust faster than defensive explanations. Speed matters in crisis - 2-hour response contained damage, Monday response would have been too late. Vulnerability is strength - admitting 'we could have communicated better' resonated more than defending 'we sent email.' Personal commitment (calling 80 customers) created credibility and showed it wasn't just PR. Financial cost (¥8M) was tiny vs brand damage avoided and loyalty built. Customers want empathy and action, not justification. Competitor attempts to exploit crisis backfired when we responded gracefully. Crisis can become brand-building moment if handled with transparency and action. CEO's values (radical transparency) guided decision - culture shows up in crisis. Team morale boost from doing right thing - employees want to work for companies with integrity. The influencer who called us out became advocate - turning critics into champions is possible. Communication protocol improvement (multi-channel for important changes) prevents recurrence. This decision required courage to respond publicly and commit personally, but paid off 10x. Best validation: Won 2 deals because prospects saw how we handled mistake. Wish I'd been even faster - responded in 1 hour not 2, but 2 hours was still good.\n\nConfidence: 0.88\nPrecedent: No", category: 'crisis_management', decision_made: 'Full disclosure within 24 hours, comprehensive security overhaul', outcome: 'SUCCESS'});
CREATE (n27:Decision {date: neo4j.time.Date(2024, 1, 5), executive_id: 'exec_004_test', confidence: 0.85, embedding_model: 'sentence-transformers/all-mpnet-base-v2', executive_name: 'Sarah Kim', title: 'Marketing Budget Allocation - 70/30 Split', financial_impact: 12000000.0, embedding_date: neo4j.time.DateTime(2025, 10, 24, 4, 45, 3, 45000000, tzinfo=<UTC>), rationale_summary: 'Brand awareness correlates with win rates. Long-term investment needed. Balanced approach: short-term pipeline + long-term brand.', embedding_dimensions: 768, precedent: False, lessons_learned: 'Brand takes time but pays off. Balanced marketing strategy wins.', id: 'exec_004_test_DEC_001', embedding: [0.028954009, 0.048237476, -0.009305677, -0.044813707, -0.021047207, 0.011748949, 0.084949784, -0.011611458, -0.042656142, 0.00049134676, 0.021439694, 0.05188637, -0.02124168, 0.10750769, -0.037874263, 0.011383347, 0.022427358, -0.013137466, -0.053980015, -0.013162129, 0.009494945, -0.027117537, 0.022044472, -0.0007593619, -0.0077919746, -0.01000775, 0.040295016, 0.0014492322, -0.04184679, -0.0075642974, -0.047998793, -0.05977863, -0.024676757, 0.020610426, 2.2874997e-06, -0.019807767, -0.035689164, -0.004195422, -0.028559906, 0.022297038, -0.030669486, -0.0025310474, -0.018217191, 0.03098344, 0.0019375056, -0.012954586, 0.01141682, -0.02798802, -0.00026801365, 0.0028786005, -0.013499168, 0.052913588, -0.117492825, 0.003089988, -0.11745702, -0.017557787, -0.0479763, 0.03737054, 0.0018763269, -0.0058248066, -0.0015250609, 0.053605482, 0.015089134, -0.039945494, 0.014927121, 0.045823015, -0.0068541053, 0.006774257, -0.015561288, -0.025706278, 0.0038020038, 0.059487507, -0.01592398, -0.012307058, 0.0012692558, -0.0004861656, 0.025784358, -0.035524808, 0.031175487, -0.01979587, -0.058826547, -0.026002612, -0.015206553, -0.04374294, -0.03682937, 0.036124837, 0.004724367, 0.0077925413, 0.015162645, 0.015037947, 0.06944082, -0.026543254, 0.03108974, 0.011283664, -0.023517821, -0.009147484, 0.035535607,