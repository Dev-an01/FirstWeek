014130006, 0.032796532, 0.04229456, 0.007576251, -0.07219598, 0.018872328, -0.00432618, 0.026357172, -5.8861767e-33, 0.06287274, -0.03177947, 0.01041928, -0.023542456, -0.019413004, 0.056341972, 0.0014141311, 0.00809251, -0.02452147, -0.06781575, -0.031800717, -0.0076673236, 0.023115776, 0.0014478719, 0.06601063, 0.01085479, -0.00041032667, -0.023167722, -0.029462174, -0.0337469, -0.0030919008, -0.012795953, 0.008342744, -0.04034245, -0.018006407, 0.08831242, 0.011398329, 0.02492104, -0.04060826, 0.005927769, 0.06882814, 0.023761546, 0.003983595, -0.10865051, 0.0023937062, -0.008356098, 0.00811971, -0.011124914, -0.03987092, -0.016512565, 0.0017831061, 0.0039956137, 0.025860954, 0.036298778, 0.015836503, -0.008888325, -0.009737525, -0.031387262, 0.005291119, -0.015331295, -0.059540365, 0.019388398, -0.031968635, 0.077697136, 0.03288552, 0.020496609, -0.026318755, 0.024279606, -0.03729153, -0.0012963732, -0.043631185, -0.045821935, 0.010541256, -0.017163666, 0.006262419, 0.0038148512, 0.008180278, 0.013079287, -0.019736158, -0.0604348, -0.005448971, 0.045774765, 0.013063738, -0.050799288, 0.016883936, -0.0033442103, -0.032783154, 0.04047451, 0.051431794, 0.054836858, 0.0061673922, 0.034615736, -0.070245415, -0.024634473, 0.083413154, -0.052264433, -0.01931727, 0.007147006, 0.016371086, 0.012509548, -0.025059832, 0.028055066, 0.032604773, -0.017934443, 0.053130355, -0.017166553, 0.035619147, 0.045476016, 0.0072696847, 0.008937773, -0.0029050056, -0.0013039315, 0.052890435, 0.03223826, 0.012560178, -0.00485075, -0.003918673, -0.004739024, 0.005146698, 0.022527955, 0.005262744, -0.006665686, 0.052580148, -0.00041615777, -0.012709136, 0.005973394, 0.008097757, -0.052585863, 0.045291234, 0.02534659, -0.03751819, -0.006605768, -0.02213848, -0.07037364, 0.0075123175, 0.03800445, 0.015017703, 0.024091046, -0.010074705, -0.051132735, -0.007876199, 0.021705832, 3.012712e-07, -0.0023198014, -0.022309935, -0.047001556, -0.015099334, 0.002674732, 0.043078188, -0.015084066, -0.04415717, 0.010583793, 0.03071706, 0.11589259, -0.008081608, -0.02383625, -0.000895071, 0.038165815, -0.10507247, 0.04050344, 0.0012436202, -0.037769143, -0.013514207, 0.08439057, 0.014904314, 0.012645449, -0.02159917, 0.019328406, -0.0013267313, -0.0041042017, -0.024868751, 0.060306896, -0.016337356, 0.069026664, 0.0059915087, -0.037861947, -0.009109028, -0.01565139, 0.0028453083, 0.00478206, 0.012339975, 0.02848359, 0.014374671, 0.038347784, 0.0074757496, 0.04416614, -0.010487511, 0.038004007, -0.03409946, -0.050422527, -0.047319874, -0.0066187223, -0.020960419, 0.0108119715, 0.029575529, 0.02166957, 0.017976375, -0.03492446, -0.050095975, 0.011453487, -0.0006925508, 0.0017290944, 0.0590963, -0.018479384, 0.01069238, -0.006498338, 0.04258907, 0.052359805, -0.011080764, 0.032976184, 2.9689447e-34, -0.03284298, -0.08439843, 0.025836144, -0.0041375034, -0.01645104, 0.008433553, -0.026630446, -0.03340474, 0.016959134, -0.029054608, -0.032142837], embedding_text: "Decision Case: Untitled Decision\nDecision ID: exec_001_test_DEC_002\nExecutive: exec_001_test\nCategory: product_investment\nDate: 2024-05-20\n\nSituation:\nOur product team conducted customer research showing 65% of enterprise prospects are asking for AI-powered features (intelligent search, automated recommendations, chatbot support). Three of our largest prospects (combined ¥45M potential annual value) explicitly stated AI features are requirements for their shortlist. VP Product, Kenji Tanaka, proposed a ¥40M investment over 6 months to build comprehensive AI capabilities across all three products. The proposal included hiring 8 ML engineers, investing in AI infrastructure, and allocating 60% of product team to AI initiatives. However, our CTO raised concerns: engineering team is at 85% utilization, we have significant technical debt in our core platform, and rushed AI implementation could compromise product quality. Board members are excited about AI positioning for next fundraise but CTO warned we're not ready. Market timing pressure is real - competitors are announcing AI features.\n\nDecision Made:\nApproved Option 3 (Pilot) with specific constraints: ¥12M budget, 3-month timeline, limited scope to AI-powered search in WorkFlow Pro (our flagship product only). Required team to address top 3 technical debt items first (1 month preparation). Approved hiring 2 senior ML engineers before project starts (not 8). Made clear this is Phase 1 - we'll learn, measure, then decide on Phase 2 investment. Set success metrics: customer NPS improvement, search effectiveness, and technical quality standards.\n\nRationale:\nThis decision prioritizes Sustainable Growth over rapid expansion. Here's my reasoning: (1) Risk Management - ¥40M without validation is too risky. ¥12M pilot lets us learn at 30% of cost. (2) Team Capacity - Adding major initiative to 85% utilized team guarantees quality problems. One month to address technical debt plus ramping up is more realistic. (3) Build vs Buy - We decided to build (not vendor) because search is core to our value proposition, but limit scope to prove we can execute. (4) Market Positioning - One AI feature done really well beats multiple mediocre features. We can position as thoughtful AI adoption vs rushed competitor announcements. (5) Learning - Pilots reveal what customers really value vs what they say they want. This aligns with our Operational Excellence value (do it right) and Sustainable Growth (don't overextend). Yes, we might lose the 3 prospects, but if we can't deliver quality AI, we'd lose them eventually anyway.\n\nOutcome:\nMIXED RESULTS - Pilot launched on time after 1-month technical debt sprint. AI search in WorkFlow Pro exceeded expectations - NPS increased 12 points for users who tried it, search effectiveness up 40%. Customer feedback: 'Finally, search that understands what I mean.' However, we discovered our data quality issues were worse than expected - needed additional 2 months to clean and structure data properly. Total pilot cost: ¥15M (vs ¥12M budgeted). Of the 3 large prospects, we won 1 (¥18M) with AI search demo, lost 2 to competitors who had broader AI. But the 1 we won is thriving. Team learned critical lessons about data infrastructure requirements for AI. Board initially disappointed we didn't go bigger, but after seeing pilot quality and learnings, approved ¥30M Phase 2 with realistic 9-month timeline.\n\nLessons Learned:\nPilots are essential for new technology - they reveal hidden complexity (data quality in our case). Our cautious approach avoided betting ¥40M on flawed assumptions. The 2 prospects we lost would have churned anyway if we'd delivered poor AI. Better to do one thing exceptionally than many things poorly. Data infrastructure is prerequisite for AI, not something you fix later. VP Product initially frustrated but now champions measured approach. CTO's concerns were valid - technical debt would have compounded. Our estimate was 80% accurate (¥15M vs ¥12M), which is acceptable for new territory.\n\nConfidence: 0.78\nPrecedent: No", category: 'product_investment', decision_made: 'Approved ¥12M pilot (vs ¥40M full request), prove value before scaling', outcome: 'SUCCESS'});
CREATE (n12:Decision {date: neo4j.time.Date(2024, 6, 30), executive_id: 'exec_001_test', confidence: 0.92, embedding_model: 'sentence-transformers/all-mpnet-base-v2', executive_name: 'Akiko Tanaka', title: 'Career Development Program Post-VP Departure', financial_impact: 5000000.0, embedding_date: neo4j.time.DateTime(2025, 10, 24, 4, 45, 2, 967000000, tzinfo=<UTC>), rationale_summary: 'Attrition signal from VP Engineering departure. Systemic fix better than counter-offers. Investment in all employees vs bidding wars.', embedding_dimensions: 768, precedent: False, lessons_learned: 'People issues require systemic solutions. Career growth is retention strategy. Transparency about challenges builds trust.', id: 'exec_001_test_DEC_003', embedding: [0.06044136, 0.052419905, 0.012784429, -0.026317623, 0.03167269, 0.010730555, -0.06260178, 0.05802283, -0.047570854, 0.015876187, -0.06382828, 0.034948066, -0.011419876, 0.02308521, -0.05206615, -0.0036968582, 0.0028100556, 0.0034732062, 0.039288417, -0.03798013, 0.01636309, 0.0067505976, 0.032191638, 0.019843249, 0.015341479, 0.0049906634, 0.07477007, 0.014010396, 0.03182309, -0.03718815, 0.005017639, 0.01569424, -0.0063122706, -0.040060133, 2.0012321e-06, -0.023731304, -0.049264356, -0.011698563, -0.035614077, 0.012891909, -0.049027037, -0.02960791, -0.060941327, 0.013954477, -0.0116506005, 0.026946908, -0.002986318, 0.025735602, 0.05181126, 0.050764762, 0.0022848335, -0.049999814, -0.03423634, -0.05871033, -0.061231602, -0.05361922, -0.008572078, -0.051903147, 0.017102692, 0.014865966, -0.008926849, 0.0047508124, 0.003477917, -0.039659075, -0.023392377, 0.020557463, 0.041681126, 0.026403576, 0.041696645, -0.020705676, 0.06520555, 0.06272757, 0.016697498, 0.027467001, 0.036998954, -0.01171579, 0.053099442, 0.024154572, -0.049014945, -0.015776569, 0.010803512, 0.07509382, -0.049321372, -0.02215182, 0.016656999, 0.012477453, -0.007586264, -0.006680902, 0.03439457, 0.04111007, 0.052205194, -0.067044504, -0.0014439365, 0.01939554