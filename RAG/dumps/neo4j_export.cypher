0.032326266, 0.01858908, 0.0023736767, 0.024752757, -0.0040965606, 0.034623455, 0.039124474, -0.0045467485, -0.05760095, -0.020654295, 0.0020002695, 0.0076243035, -0.013217342, -0.0015079743, 0.010121839, -0.0058321636, 0.016434753, 0.049333695, 0.08133614, 0.024415737, -0.015359361, 0.009758833, -0.11912699, -0.010387495, -0.036836103, 0.012657648, 0.07415993, -0.031236703, 0.02179182, 0.036352098, -0.028649202, 0.028416181, 0.012021114, 0.009979167, 0.011284352, -0.0075600594, -0.032193672, 0.007448548, 0.0062723137, 0.05511642, 0.0071018026, 0.0024806757, -0.07321008, 0.027356578, 0.0419914, 0.025203876, 0.021880668, 0.027634548, 2.495247e-34, 0.008821871, -0.08618956, -0.00021967654, 0.026228493, 0.0037316643, -0.010728381, -0.008687274, 0.0013040792, -0.0063781366, -0.06678809, -0.046148013], embedding_text: 'Policy: Procurement Policy\nVersion: None\nID: POLICY-FIN-006\n\nContent:\n# Procurement Policy\n\n**Document ID**: POLICY-FIN-006  \n**Version**: 1.4  \n**Effective Date**: February 1, 2024  \n**Owner**: CFO Office (Raj Patel)  \n**Last Updated**: February 1, 2024  \n**Review Frequency**: Annually  \n**Confidentiality**: Internal\n\n---\n\n## 1. Purpose\n\nThis policy establishes guidelines for purchasing goods and services to ensure:\n- Cost-effective procurement\n- Proper vendor evaluation and selection\n- Compliance with budget approvals\n- Risk management in vendor relationships\n- Ethical purchasing practices\n\n---\n\n## 2. Scope\n\nApplies to all purchases of:\n- Software and SaaS subscriptions\n- Hardware and equipment\n- Professional services (consulting, legal, audit)\n- Marketing and advertising services\n- Office supplies and facilities\n- Travel and events (see separate Travel Policy)\n\n**Exclusions**: Employee compensation, benefits, and reimbursements (separate policies apply)\n\n---\n\n## 3. Approval Thresholds\n\n### 3.1 Purchase Approval Limits\n\n| Amount (¥) | Approval Required | Vendor Selection | RFP Required |\n|-----------|------------------|------------------|--------------|\n| < 500K | Requestor + Manager | Single vendor OK | No |\n| 500K - 2M | Manager + Department Head | 2 quotes preferred | No |\n| 2M - 10M | Department Head + CFO | 3 quotes required | Recommended |\n| 10M - 30M | VP + CFO | 3 quotes required | Yes |\n| > 30M | VP + CFO + CEO | Formal RFP process | Yes |\n\n### 3.2 Contract Duration Considerations\n\n**Multi-year contracts**:\n- Total contract value used for approval (not annual)\n- Example: ¥8M/year × 3 years = ¥24M (requires VP + CFO approval)\n\n**Automatic renewals**:\n- Treated as new contract at renewal\n- Re-approval required if value exceeds thresholds\n\n---\n\n## 4. Vendor Selection Process\n\n### 4.1 Pre-Qualified Vendors\n\n**Preferred vendors** (pre-approved for recurring purchases):\n- Office supplies: Office Depot KK\n- Cloud infrastructure: AWS, Google Cloud\n- Travel booking: JTB Business Travel\n- Shipping: Yamato Transport\n\n**Benefits**:\n- Faster procurement (no vendor evaluation)\n- Negotiated corporate rates\n- Established payment terms\n\n### 4.2 New Vendor Evaluation\n\n**For purchases >¥2M**, evaluate vendors on:\n\n**Capability** (40%):\n- Experience and track record\n- References from similar companies\n- Technical expertise\n- Capacity to deliver\n\n**Cost** (30%):\n- Total cost of ownership\n- Payment terms\n- Discount opportunities\n- Hidden costs\n\n**Risk** (20%):\n- Financial stability\n- Data security (if accessing our data)\n- Business continuity plans\n- Insurance coverage\n\n**Cultural Fit** (10%):\n- Values alignment\n- Communication style\n- Customer service approach\n- Long-term partnership potential\n\n### 4.3 Vendor Due Diligence\n\n**For vendors with data access** (see Information Security Policy):\n- ☐ Security questionnaire\n- ☐ SOC 2 / ISO 27001 certification\n- ☐ Data Processing Agreement (DPA)\n- ☐ Insurance verification (cyber liability)\n- ☐ References checked\n\n**For all vendors >¥10M**:\n- ☐ Financial statements reviewed\n- ☐ Credit check\n- ☐ Business registration verified\n- ☐ Anti-corruption/sanctions screening\n\n---\n\n## 5. Request for Proposal (RFP) Process\n\n### 5.1 When RFP Required\n\n**Mandatory for**:\n- Purchases >¥10M\n- Strategic vendor relationships\n- Complex projects with multiple vendors\n- Government/regulated industry requirements\n\n**Optional but recommended for**:\n- Purchases ¥2M - ¥10M\n- First-time vendor categories\n- Competitive markets with many options\n\n### 5.2 RFP Structure\n\n**RFP must include**:\n1. Company background and context\n2. Project scope and requirements\n3. Technical specifications\n4. Timeline and milestones\n5. Evaluation criteria and weights\n6. Budget range (optional)\n7. Proposal format and deadline\n8. Terms and conditions\n\n**Timeline**:\n- RFP preparation: 1-2 weeks\n- Vendor response period: 2-3 weeks\n- Evaluation and selection: 1-2 weeks\n- Negotiation: 1-2 weeks\n- **Total**: 6-9 weeks\n\n### 5.3 Vendor Shortlisting\n\n**Minimum 3 vendors** invited to submit proposals\n\n**Shortlist criteria**:\n- Meet minimum requirements\n- Appropriate company size/experience\n- Geographic presence (if relevant)\n- Budget compatibility\n\n**Exceptions**: Sole-source procurement (Section 5.5)\n\n### 5.4 Proposal Evaluation\n\n**Evaluation committee**:\n- Requestor (business owner)\n- Department head\n- Finance representative\n- Technical expert (if applicable)\n\n**Scoring**:\n- Blind evaluation (remove vendor names initially)\n- Each committee member scores independently\n- Discuss discrepancies\n- Consensus decision\n\n**Documentation**:\n- Evaluation matrix with scores\n- Decision rationale\n- Vendor feedback (if requested)\n\n### 5.5 Sole-Source Justification\n\n**When only one vendor acceptable**:\n- Proprietary/patented solution\n- Existing vendor lock-in (migration cost prohibitive)\n- Emergency/time-critical situation\n- Regulatory requirement\n\n**Approval required**:\n- Written justification\n- CFO approval (all sole-source >¥2M)\n- CEO approval (sole-source >¥10M)\n\n---\n\n## 6. Contract Management\n\n### 6.1 Contract Requirements\n\n**All contracts >¥500K must include**:\n- ☐ Scope of work / deliverables\n- ☐ Payment terms and schedule\n- ☐ Timeline and milestones\n- ☐ Acceptance criteria\n- ☐ Warranties and representations\n- ☐ Limitation of liability\n- ☐ Termination clause\n- ☐ Data security terms (if applicable)\n- ☐ Confidentiality/NDA\n- ☐ Dispute resolution process\n\n**Legal review required**:\n- All contracts >¥5M\n- All multi-year contracts\n- Any non-standard terms\n- Master Service Agreements (MSAs)\n\n### 6.2 Contract Approval Workflow\n\n1. **Requestor** initiates contract in procurement system\n2. **Department head** approves business terms\n3. **Finance** reviews pricing and payment terms\n4. **Legal** reviews contract language (if required)\n5. **CFO** approves (if >¥2M)\n6. **CEO** approves (if >¥30M)\n7. **Signature** by authorized signatory\n\n**Timeline target**: 5 business days for standard contracts\n\n### 6.3 Contract Storage\n\n**Central repository**: All contracts stored in ContractWorks system\n- Searchable by vendor, date, value, owner\n- Automatic renewal reminders (90 days advance)\n- Expiration tracking\n- Amendment tracking\n\n**Access**:\n- Contract owner: Full access\n- Department head: Department contracts\n- Finance/Legal: All contracts\n- Executives: All contracts\n\n---\n\n## 7. Software and SaaS Procurement\n\n### 7.1 Software Categories\n\n**Approved software** (no additional approval needed):\n- Microsoft 365\n- Google Workspace\n- Slack\n- Zoom\n- Standard development tools\n\n**Requires approval**:\n- New SaaS subscriptions\n- Seat expansions >10%\n- Upgrades to higher tier\n\n### 7.2 SaaS Evaluation Criteria\n\n**Must evaluate**:\n- ✓ Business need (is it solving real problem?)\n- ✓ Existing alternatives (do we already have this capability?)\n- ✓ Total cost of ownership (licenses + implementation + training)\n- ✓ Integration with existing tools\n- ✓ Data security and privacy\n- ✓ Vendor stability and roadmap\n- ✓ User adoption likelihood\n\n**Build vs Buy assessment**:\n- For core capabilities, consider building\n- See CTO decision framework (DC_YUKI_002)\n- Generally prefer buying non-core tools\n\n### 7.3 SaaS Contract Terms\n\n**Negotiate for**:\n- Annual (not monthly) billing with discount\n- Multi-year commitments with price lock\n- Flexible seat scaling (up and down)\n- Data export capabilities\n- Service level agreements (SLAs)\n- Termination rights (avoid long lock-ins)\n\n**Red flags**:\n- Automatic renewal without opt-out\n- Aggressive price escalation clauses\n- No data portability\n- Broad indemnification requirements\n- Unclear data ownership\n\n---\n\n## 8. Professional Services Procurement\n\n### 8.1 Consulting Services\n\n**When to use consultants**:\n- Specialized expertise not in-house\n- Temporary capacity needs\n- Independent perspective needed\n- Knowledge transfer to employees\n\n**Approval**:\n- <¥5M: Department head\n- ¥5M - ¥20M: VP + CFO\n- >¥20M: CEO\n\n**Contract types**:\n- Time & materials (T&M): Hourly rate, suitable for undefined scope\n- Fixed price: Total price for defined deliverables\n- Retainer: M\n\n[Content truncated due to length...]', category: 'Finance'});
CREATE (n39:Policy {file_path: 'test_data/policies/sales_compensation_policy.md', last_updated: neo4j.time.Date(2024, 1, 1), confidentiality: 'Internal', embedding_model: 'sentence-transformers/all-mpnet-base-v2', owner_executive: 'Raj Patel', review_frequency: 'Annually', version: '2.3', embedding_date: neo4j.time.DateTime(2025, 10, 24, 4, 45, 3, 247000000, tzinfo=<UTC>), embedding_dimensions: 768, name: 'Sales Compensation Policy', effective_date: neo4j.time.Date(2024, 1, 1), id: 'POLICY-SALES-001', embedding: [0.02454108, 0.008990681, -0.019705418, -0.029425846, 0.036021717, 0.026508622, 0.0074515967, 0.038410045, -0.06771045, -0.045303438, -0.031405948, 0.042334516, 0.033496704, 0.0019162674, -0.042580113, -0.03838208, 0.012827518, 0.03493648, 0.02395584, -0.0016439587, 0.0062197875, -0.011484676, -0.038224448, -0.00088754116, -0.013782272, -0.02384137, 0.06970702, -0.05378915, 0.0043981737, 0.004284375, 0.04157202, 0.005978323, 0.069402695, -0.019965071, 2.0517773e-06, -0.0060179946, -0.030159047, 0.01201532, -0.01830139, 0.05714609, 0.026181964, -0.030062215, -0.010338239, 0.008936017, 0.017390924, 0.024834566, -0.007872422, 0.06667324, 0.059133757, 0.003973676, 0.0009084241, -0.08201043, -0.081915624, 0.0009905468, -0.004814459, -0.04469749, -0.032755185, -0.04274782, -0.08189518, -0.05394648, -0.044289455, -0.0136577375, 0.03643392, 0.0048443414, 0.027468344, 0.031622894, 0.011901188, -0.03300586, 0.030803759, 0.0097769955, 0.09513195, 0.023036486, -0.0046995487, 0.029776264, 0.02851355, -0.02614022, -0.0010024036, 0.042774413, -0.034226008, -0.03608799, 0.010831363, 0.14018542, -0.010845574, -0.03425673, 0.035714194, 0.01368213, -0.037465535, -0.031134149, -0.010626792, -0.016954536, -0.005872759, 0.0074523548, -0.015002286, 0.036571383, -0.064409316, 0.017016979, 0.06026821, -0.0031779115, 0.014473172, -0.05798028, 0.019154659, 0.014069147, 0.044485226, -0.010652289, 0.02164894, 0.022651782, -0.036817633, 0.03768369, -0.032945894, 0.044309407, 0.05578627, 