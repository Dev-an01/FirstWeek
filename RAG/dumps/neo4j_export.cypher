129013825, 0.028507607, 0.05087543, 0.012559403, 0.006330301, -0.04839331, 0.04451785, 0.013421193, -5.719511e-33, 0.043057006, -0.035953887, -0.0019373355, -0.04439054, 0.025634304, 0.014389092, -0.019342942, 0.01917418, 0.013805824, -0.045746267, -0.006360189, -0.0002403044, 0.03494113, 0.025084483, 0.049168315, 0.045062914, -0.0009847425, -0.007798641, -0.016735783, -0.0345003, 0.003552527, -0.03725916, 0.013245928, -0.09299025, 0.011225794, -0.0069580157, 0.05496254, 0.00039264045, -0.020509878, -0.013090779, 0.028002923, 0.012051659, 0.013960437, -0.0065180934, 0.042541675, 0.03777561, 0.0050185155, 0.01770805, -0.039482877, -0.0043758815, -0.0038485583, 0.03560701, 0.027999533, 0.028867375, 0.04123857, 0.013043191, 0.0037594137, -0.06665976, -0.0042670364, -0.018391302, -0.067108974, 0.004895583, -0.017147042, 0.06501142, 0.0048718224, 0.040205684, -0.04037012, 0.028506044, -0.019100068, -0.029783575, -0.06621761, -0.041510742, -0.01139793, -0.033709686, -0.058586486, -0.038104847, -0.042098932, -0.07155082, 0.010651616, -0.064915575, -0.032394275, 0.054051403, 0.039410546, -0.010544138, -0.003270769, -0.023773897, -0.016804859, 0.027830495, 0.05810085, 0.016883284, 0.025582058, 0.044577613, -0.035438575, -0.031912442, 0.08076175, -0.027757635, -0.027283654, -0.011927788, 0.025698803, 0.06339473, -0.015358107, 0.016027989, 0.0021271068, 0.022533178, 0.0014092638, -0.0650545, 0.01268538, 0.005034657, 0.022013905, -0.0114263855, 0.0013802253, 0.03333917, -0.033464048, 0.04036213, -0.016633108, -0.0175142, -0.015263771, -0.039481234, 0.013698315, 0.064086966, 0.036058716, 0.013658265, -0.010560731, 0.015028543, -0.02320872, -0.028976677, -0.021288907, -0.020908127, -0.0017667321, 0.011185466, -0.030492876, -0.013810033, -0.036224145, -0.08852111, -0.021504438, 0.039532315, 0.032485005, 0.008700846, 0.019819712, -0.0037943302, 0.00072999106, -0.038314357, 2.9873857e-07, 0.007578498, -0.040635124, -0.053574752, 0.021227319, 0.00913758, 0.093483984, 0.035716977, -0.020650933, 0.023344098, 0.005974363, 0.030549865, -0.052947324, 0.020041203, 0.037952475, 0.08858916, -0.08507551, 0.04857505, -0.0037381272, -0.020329576, 0.009177517, 0.1013932, -0.008767479, 0.027073858, -0.01768225, 0.04111808, 0.012262771, -0.02741932, -0.022792699, 0.043683864, 0.0012730835, 0.047535032, -0.0033483433, -0.04359281, -0.028710501, -0.027495006, -0.010102226, 0.0011956956, 0.031279698, 0.026095502, 0.006692309, 0.06353658, -0.040001646, 0.050141774, 0.0032095334, 0.0044011916, -0.061676227, -0.02245441, 0.022830073, 0.00293899, -0.015149599, -0.0017504222, 0.03011358, -0.014388707, 0.013330429, -0.00851334, -0.033650465, 0.03654085, -0.023737777, 0.005353061, 0.13261698, -0.0073957667, 0.027466249, 0.006463789, 0.025163008, 0.0021054805, 0.021013014, 0.007794401, 2.9007865e-34, -0.030506756, -0.01135568, 0.03027491, 0.023743818, -0.021023752, 0.020681022, -0.00020047837, -0.026517794, 0.016855424, 0.006933788, -0.022291644], embedding_text: "Decision Case: Untitled Decision\nDecision ID: exec_003_test_DEC_002\nExecutive: exec_003_test\nCategory: build_vs_buy\nDate: 2024-03-15\n\nSituation:\nOur customer support team using Zendesk for ticket management, but it wasn't integrating well with our products. Customers had to: (1) Log into our app, (2) Find issue, (3) Go to separate Zendesk portal, (4) Describe issue again (no context from our app), (5) Wait for support to manually look up their account in our system. Support team frustrated by manual work, customers frustrated by clunky experience. VP Customer Success proposed: 'Let's build in-app support system. Customers can report issues directly in product, we see all their context automatically, much better experience.' They showed mockups - looked slick. Rough estimate from product team: 4 engineers, 4 months to build, ongoing maintenance. Meanwhile, I found that several SaaS support tools existed with embeddable widgets (Intercom, HelpScout, Zendesk itself had better integration). Cost: ¥3-5M per year for 450 customers. Build cost: ¥20M development (4 engineers × 4 months × ¥1.25M fully loaded cost) + ¥8M annual maintenance (1 engineer ongoing). Break-even: 10+ years if we built. But VP Customer Success argued: 'Buying means we're dependent on vendor. They can raise prices. We can't customize to our needs. Building gives us control and becomes competitive advantage.' Product team excited to build (engineers love building tools). However, my assessment: (1) Support system is not our core competency - we build B2B productivity software, not customer support tools. (2) Vendor solutions are mature (10+ years development), ours would be V1 with bugs. (3) Our 4 engineers could build customer-facing features instead - estimated ¥60M revenue impact if they worked on core product. (4) 'Vendor lock-in' fear is overblown - we can switch vendors much easier than rewriting in-house system. CEO Akiko wanted my technical and strategic input.\n\nDecision Made:\nOption 2 with clear rationale: Buy Intercom (¥4M/year). Specific decisions: (1) Implement Intercom embedded widget in all three products (WorkFlow, TeamSync, TalentHub). (2) Build thin API integration layer (2 weeks, 1 engineer) to pass user context to Intercom automatically. (3) Allocate the 4 engineers who would have built support system to core product features (AI features, mid-market expansion). (4) Set 'build vs buy' decision framework for future: Build if (a) core to competitive advantage, (b) vendors don't meet needs, (c) ROI positive in <3 years. Otherwise buy. (5) Made public eng blog post about this decision to explain rationale to team (teaching moment about build vs buy).\n\nRationale:\nThis is classic build vs buy trap. Here's my thinking: (1) Math Doesn't Lie - Building costs ¥28M over 5 years (¥20M dev + ¥8M × 1 year maintenance). Buying costs ¥20M over 5 years (¥4M × 5 years). We save ¥8M by buying. But real cost is opportunity cost: 4 engineers for 4 months = 16 engineer-months NOT building core product. We estimated those 16 engineer-months on AI features would generate ¥60M revenue. So real cost of building is ¥60M opportunity cost + ¥28M direct cost = ¥88M. Buying is ¥20M. No-brainer. (2) Not Our Core Competency - We build B2B productivity software. Customer support tools are different domain. Intercom has 200+ engineers working on support tools for 10 years. Our 4 engineers can't replicate that in 4 months. We'd ship V1 with basic features while Intercom has 100 features we didn't think of. (3) 'Vendor Lock-in' is Fear Not Reality - Yes, Intercom could raise prices. But switching from Intercom to HelpScout is 1-week project (change API calls). Switching from our custom-built system to vendor is 3-month project (rewrite everything). Building creates MORE lock-in, not less. (4) Control is Overrated - VP Customer Success wants 'full control to customize.' But 90% of customization is configuration (Intercom has this), not code changes. The 10% we can't customize isn't worth ¥60M opportunity cost. (5) Team Wants to Build (Wrong Reason) - Engineers love building tools. It's resume-driven development ('I built a support system!'). But my job as CTO is strategic resource allocation, not keeping engineers happy with toy projects. They'll be happier building features customers pay for. (6) Speed Matters - Intercom is 2 weeks to implement. Building is 4+ months (likely 6 in reality). Customer Success gets their solution 4 months faster. This honors Pragmatism Over Perfection (buy works fine), Bias for Action (ship solution in 2 weeks not 6 months), and Engineering Excellence (focus engineering on what we do best). Yes, team disappointed initially, but this is leadership: making right call even when unpopular.\n\nOutcome:\nSUCCESS - Nine months later: (1) Intercom implemented in 2.5 weeks (vs 2-week estimate). (2) Customer satisfaction with support improved dramatically: CSAT score 68 → 84. (3) Support team efficiency up 40% (no more manual context lookup). (4) Cost: ¥4M annually as planned, well within budget. (5) The 4 engineers worked on AI search feature instead, which shipped 3 months later and drove ¥22M new revenue (vs estimated ¥60M over longer period, still great ROI). (6) Zero regrets about not building - Intercom worked great and added features we would never have thought of (customer health scoring, proactive messages, analytics). (7) Team initial disappointment turned to acceptance after seeing how much faster we shipped with engineers on core product. (8) One senior engineer said in retro: 'Glad we didn't build this. Would have been fun but Intercom is actually better than what we would've made.' (9) Established clear build vs buy framework that we use for all future decisions. (10) CFO Raj loved this decision - called it 'textbook capital allocation.' (11) Board member (technical background) praised decision as example of 'disciplined technical leadership.' (12) Two other companies in our portfolio asked us about our decision process after seeing results. (13) Blog post about 'Build vs Buy' decision framework got 5K views, positioned us as thoughtful technical team. (14) We've since applied same framework to: analytics (bought Mixpanel), error tracking (bought Sentry), email delivery (bought SendGrid) - all good decisions. (15) If we had built, we'd be maintaining 4 internal tools now. Instead, vendors maintain them and we build customer-facing features.\n\nLessons Learned:\nBuild vs buy is emotional, not rational - engineers want to build, PMs want control. But economics are clear: buy unless it's core competitive advantage. Opportunity cost is real cost - 4 engineers on support system means 4 engineers NOT on revenue-generating features. Vendor solutions are almost always more mature than what small team can build. 'Vendor lock-in' fear is overblown - switching vendors is easier than maintaining in-house system. Speed matters: 2 weeks vs 6 months means customers get value 4 months sooner. This decision saved us ¥60M+ in opportunity cost and let us ship AI features that actually made money. The engineers who wanted to build came around after seeing results. Sometimes CTO must say no to fun projects and yes to boring-but-right decisions. Framework for build vs buy (core competency + vendor gaps + <3 year ROI) is now used company-wide. Best compliment: engineer said 'I wanted to build this but you were right to buy it.' That's trust.\n\nConfidence: 0.92\nPrecedent: No", category: 'brand_strategy', decision_made: "Repositioned from 'Enterprise-grade' to 'Scales with you', ¥25M investment", outcome: 'SUCCESS'});
CREATE (n29:Decision {date: neo4j.time.Date(2024, 6, 1), executive_id: 'exec_004_test', confidence: 0.95, embedding_model: 'sentence-transformers/all-mpnet-base-v2', executive_name: 'Sarah Kim', title: 'Marketing-Sales Alignment - SRL Definition', financial_impact: 0.0, embedding_date: neo4j.time.DateTime(2025, 10, 24, 4, 45, 3, 65000000, tzinfo=<UTC>), rationale_summary: 'Lead quality was 12% conversion. Sales frustrated. New SRL definition: 38% conversion. Weekly Revenue Team meetings.', embedding_dimensions: 768, precedent: True, lessons_learned: 'Alignment matters more than volume. Quality over quantity.', id: 'exec_004_test_DEC_003', embedding: [0.032035656, 0.01512551, -0.019981017, -0.015712649, 0.05556852, 0.048316248, -0.03324392, 0.02163745, -0.04773371, 0.022216061, 0.0018486431, 0.05368406, -0.031397194, 0.07232667, -0.013091001, 0.035967607, -0.032930978, 0.026228793, 0.036133233, -0.020836502, 0.020256208, -0.021383405, 0.028602108, -0.014619866, 0.011469524, 0.029892707, 0.041545868, -0.01632058, 0.0036511836, -0.031774465, 0.029047325, -0.0013315153, -0.019936169, -0.08648448, 2.434091e-06, -0.009902276, -0.05624865, -0.056036796, -0.031528965, 0.051564854, -0.02135664, -0.012202178, -0.048207816, 0.011794016, -0.023615235, 0.030986467, -0.018682374, 0.09127834, 0.026871644, 0.03631955, 0.011908665, 0.0013051201, -0.059690908, -0.019966323, -0.076973796, -0.050233677, -0.020682711, -0.020296369, 0.020267874, 6.0906368e-05, -0.017029727, 0.012462965, 0.0141678145, -0.03295599, -0.005659207, 0.07456196, 0.07367022, -0.016745238, 0.06139259, 0.003546569, 0.022214638, 0.0023101121, -0.006933465, -0.0030962897, 0.031344652, -0.06691764, 0.04648235, -0.03235122, -0.0032824776, 0.0020354881, -0.041694526, 0.061103072, -0.02694531, -0.022934396, -0.02470651, -0.0072717736, -0.029284112, -0.013941397, 0.000942641, 0.053795684, 0.04446531, -0.030840766, -0.026207503, 0.016169727, -0.016766604, 0.015997339, 0.0779141, -0.002759962, 0.002456937, -0.039313912, -0