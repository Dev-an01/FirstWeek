3, -0.045886517, 0.04028787, -0.0013453776, -0.01866392, -5.5738816e-33, 0.050592873, -0.028267954, -0.025495706, 0.020786744, 0.003818685, 0.05634202, -0.00623149, -0.023551052, 0.0072145523, -0.015418071, -0.049615785, 0.018678492, 0.01792708, 0.00019152566, 0.024827998, 0.0037987593, -0.008227126, 0.0026610235, 0.0026538984, -0.061364584, -0.019894276, 0.0085389605, 0.041007448, -0.05426821, -0.01863858, 0.046770163, 0.0010591919, 0.024018204, -0.061331343, 0.025920449, 0.02002983, -0.005707983, -0.0015228847, -0.057895254, 0.020093445, -0.008531219, -0.04820506, 0.017699629, -0.013066969, 0.012207354, 0.04079878, -0.0034203965, 0.011194991, 0.01955947, 0.01696442, -0.042432487, -0.047383126, -0.04915062, 0.0012778423, -0.04466386, -0.04419964, 0.02707777, -0.032971326, 0.04444836, -0.017176809, 0.03224349, -0.036062483, 0.053542994, -0.04606095, -0.0142915705, 0.00497532, -0.055850655, 0.011754529, 0.0061389552, 0.011232534, -0.0074410914, -0.035040192, -2.2777333e-05, -0.014088524, -0.062024612, -0.006587972, 0.037740763, -0.024516553, -0.02303951, 0.06651396, -0.016595544, -0.009841243, 0.017203918, 0.017253198, 0.075795755, 0.042486083, 0.0053567407, -0.036752358, -0.019078285, 0.05871096, -0.023611339, -0.024993114, -0.0054447297, 0.024231952, -0.024651736, 0.06538331, -0.012563498, -5.2625976e-05, 0.021085665, -0.023498697, -0.007054581, 0.05000637, 0.0234215, 0.045822527, -0.02355812, 0.030658966, 0.031869583, 0.012974326, 0.021870553, -0.017618125, -0.005357004, 0.051964615, -0.051614262, 0.022216504, 0.030879155, 0.029466711, -0.010585079, 0.044931233, 0.059992936, -0.036623616, 0.018463956, -0.0095808795, -0.038880046, 0.023030546, 0.0036577357, 0.016876783, 0.00979453, -0.017240096, 0.012573148, 0.006869051, 0.036535136, 0.050530776, -0.02386869, -0.009358712, -0.019881189, 0.028627923, 0.05068699, 2.9010434e-07, -0.0007920442, -0.019342657, -0.037065875, 0.04294239, -0.0018400699, 0.012575453, -0.03830181, -0.015726272, 0.05922563, 0.003305705, 0.10529844, -0.02674633, -0.024103511, -0.019192174, -0.0033814514, -0.08101781, -0.0006751568, -0.05622347, -0.017491497, 0.009562692, -0.011727128, 0.03041219, -0.0029780355, -0.041952234, 0.027419107, 0.04948703, 0.019425511, -0.05676428, 0.010338555, 0.0030022336, 0.053596873, -0.06971794, 0.020244436, -0.008829965, 0.0014837086, -0.029155754, 0.02234398, -0.0041352413, 0.03580634, 0.0047846157, 0.003379673, -0.007955021, 0.012631324, 0.016439602, 0.0146645205, -0.04055151, -0.053634707, -0.0068286937, -0.02262265, 0.008120741, 0.02623445, 0.041498285, -0.03990821, 0.03374325, -0.032069765, -0.030940717, 0.059583038, 0.022326967, 0.012576309, 0.09175642, -0.023436442, 0.027168818, -0.003558329, -0.013195602, 0.023983799, 0.008360046, -0.016694391, 2.5348826e-34, 0.013575722, -0.045761548, 0.028300298, 0.0056619477, -0.009988106, -0.02186265, 0.036696795, 0.023183757, 0.0057910345, -0.054622333, -0.043648943], embedding_text: "Decision Case: Untitled Decision\nDecision ID: exec_002_test_DEC_005\nExecutive: exec_002_test\nCategory: financial_risk\nDate: 2024-09-10\n\nSituation:\nDuring monthly financial close review, my finance team flagged concerning trend: our Days Sales Outstanding (DSO) had increased from 45 days (Q1) to 67 days (Q2) and now 78 days (Q3). This means customers are taking 78 days on average to pay invoices vs 30-day payment terms. At ¥1.1B quarterly revenue, 78-day DSO means ¥285M tied up in receivables, up from ¥165M in Q1. That's ¥120M additional working capital locked up - cash we should have but don't. If DSO reaches 90 days, we'd have ¥330M in receivables, essentially funding 3 months of customer operations. Deeper analysis revealed: (1) Sales team offering '60-day payment terms' to close deals (violates our 30-day standard). (2) Enterprise customers slow-paying without consequence (no late fees, no follow-up). (3) Our invoicing process is manual and slow - customers receive invoices 2-3 weeks after service period ends. (4) Collections process is passive - we email invoice and wait, no follow-up until 60+ days late. (5) Two customers (¥45M combined ARR) are >120 days overdue, showing financial distress. (6) Sales compensation pays on booking, not cash collection - no incentive for sales to care about payment terms. When I brought this to VP Sales and CEO, reactions were mixed. VP Sales: 'Extended payment terms help close deals, especially with large enterprises. Our competitors offer 60-90 day terms. If we tighten, we'll lose deals.' CEO Akiko: 'This is concerning from cash flow perspective, but I don't want to create customer friction. Can we fix process without changing terms?' However, my calculation showed the cost: at 78-day DSO vs target 45-day, we have ¥120M extra tied up. Our cash balance is ¥450M, so ¥120M is 27% of cash unnecessarily locked. If we could collect to 45-day DSO, we'd have ¥570M cash - wouldn't even be discussing fundraising. This is hidden cost of loose payment terms.\n\nDecision Made:\nOption 4 - Comprehensive program with 5-part implementation over 90 days: (1) Payment Terms Policy (effective October 1): Default 30-day terms for all new deals. 45-day terms allowed for customers >¥15M ARR with VP Sales approval. 60-day terms require CFO + CEO approval (exceptional cases only). All terms clearly stated in quote and contract. (2) Process Improvements: Automate invoicing (same-day as service period end). Implement collections workflow: Day 15 reminder, Day 30 follow-up call, Day 45 escalation, Day 60 late fee (2%/month). Hire 2 collections specialists (¥8M annual cost). (3) Sales Compensation Adjustment: 80% of commission paid on booking (unchanged), 20% of commission paid on cash collection within 45 days. This creates incentive for sales to care about payment terms and customer payment behavior. (4) Customer Risk Management: Two customers >120 days overdue go on payment plan or lose access. Credit checks for all >¥15M deals. (5) Reporting: Weekly DSO dashboard, monthly review with sales team, quarterly board reporting. Set target: 50-day DSO in 6 months (realistic), 45-day in 12 months (goal).\n\nRationale:\nThis requires comprehensive solution because problem has multiple root causes. Here's my reasoning: (1) ¥120M is Material - That's 27% of our cash balance. If we had ¥570M cash instead of ¥450M, entire fundraising discussion changes. This is real money, not accounting detail. For context, ¥120M tied up in receivables is equivalent to 5-6 months of burn rate. We're essentially letting customers use our cash for free. (2) Root Cause is Misaligned Incentives - Sales offers long terms because they're paid on booking, not collection. Customers pay slow because there's no consequence. We invoice slow because it's manual. You can't fix this with process alone - need to change incentives. (3) Tiered Terms Balance Needs - I'm not being rigid. Large customers (>¥15M) can get 45-day terms, which is reasonable. But 30-day should be default for most. Currently, sales offers 60-day to EVERYONE, even ¥2M customers. That's poor capital management. (4) Collections Must Be Proactive - 'Send invoice and wait' is not a collections process. Day 15 reminder, Day 30 call, Day 45 escalation, Day 60 late fee - this is standard for well-run finance orgs. We're behind industry practice. (5) Sales Comp Change Creates Ownership - 20% of commission on cash collection (within 45 days) is small enough not to hurt sales comp materially but large enough to care. This aligns sales incentives with company cash flow. (6) 90-Day Implementation is Realistic - This isn't overnight change. We're giving sales team time to adjust, customers time to adapt, and finance team time to build systems. (7) Customers Won't Leave - Competitors may offer 60-day terms, but our product value justifies 30-day terms. If customer chooses vendor purely on payment terms, they're not good customer. This honors Financial Discipline (¥120M matters), Process & Control (build sustainable collections), and Long-term Value Creation (working capital efficiency impacts valuation). Yes, VP Sales is unhappy about comp change, but it's necessary to align incentives.\n\nOutcome:\nTOO EARLY TO FULLY ASSESS (decided September 2024, 1 month ago) - but initial implementation progressing: (1) Payment terms policy announced October 1 with sales team training. Initial resistance but clear communication about why (¥120M working capital tied up). (2) Invoicing automation completed - customers now receive invoices same-day as service period ends (was 2-3 weeks delay). This alone will help. (3) Hired 2 collections specialists, starting in October. Building collections workflow. (4) Sales comp change announced for Q4 implementation - 20% of commission on cash collection within 45 days. Sales team grumbling but CEO Akiko backed me publicly, which helped. (5) Two customers >120 days overdue: One went on payment plan (paying down over 6 months), other paid in full immediately when we threatened service suspension. Recovered ¥22M. (6) Early DSO data (not full month yet): DSO tracking at 75 days (vs 78 last month) - too early to tell if trend or noise, but directionally correct. (7) Zero deals lost so far due to 30-day terms - validating my belief that customers won't leave over payment terms if product is valuable. (8) Board supportive of this initiative - they noted that best-in-class SaaS companies have 40-45 day DSO, so our 78-day was clearly problem. (9) Will have meaningful data in 3 months (end of Q4) to assess impact. Target is 65-day DSO by year-end (from 78), ¥50M working capital recovered. (10) CEO appreciated the comprehensive approach rather than piecemeal fixes. This is example of CFO driving operational excellence, not just accounting. Will report full outcome in 6 months.\n\nLessons Learned:\nCFO must monitor working capital metrics (DSO, inventory turns, payables) as closely as P&L - these impact cash flow and valuation. ¥120M tied up in receivables is real cost even though it's 'just timing.' Misaligned incentives (sales comp on booking not collection) create bad behaviors. Comprehensive solution (policy + process + incentives) beats piecemeal fixes. Collections process must be proactive and systematic, not passive. CEO support is critical when making changes that affect sales team. Board appreciates CFO who identifies and fixes operational issues, not just reports numbers. Working capital efficiency is undervalued in fast-growing companies but matters enormously. This case reminded everyone that 'revenue' and 'cash' are different - we need both. Early signs suggest we'll recover ¥100M+ of the ¥120M tied up within 6 months, which would be massive win. Sometimes CFO must drive operational changes (collections, invoicing) beyond traditional finance scope.\n\nConfidence: 0.83\nPrecedent: No", category: 'cash_management', decision_made: 'Initiated program to reduce DSO from 78 to 45 days, adjusted sales comp', outcome: 'IN_PROGRESS'});
CREATE (n21:Decision {date: neo4j.time.Date(2024, 9, 25), executive_id: 'exec_003_test', confidence: 0.95, embedding_model: 'sentence-transformers/all-mpnet-base-v2', executive_name: 'Yuki Nakamura', title: 'Quarterly Security Audits Post-Incident', financial_impact: 32000000.0, embedding_date: neo4j.time.DateTime(2025, 10, 24, 4, 45, 3, 92000000, tzinfo=<UTC>), rationale_summary: 'Security incident (DC_YUKI_005) revealed gaps. Quarterly audits catch issues faster. Bug bounty incentivizes external researchers.', embedding_dimensions: 768, precedent: False, lessons_learned: 'Prevention cheaper than incident response. Security is continuous, not one-time.', id: 'exec_003_test_DEC_001', embedding: [0.019776914, 0.08213282, -0.01012828, 0.016791873, 0.032034535, 0.008694499, -0.0834743, 0.00033724823, -0.090847276, -0.0085159, -0.0057046474, -0.015172842, 0.013600266, 0.112923115, -0.07322206, 0.03984858, -0.0110572055, 0.016204875, 0.049816914, -0.00082228973, 0.019422585, -0.03756993, 0.016512603, 0.017785236, -0.019312067, -0.035692144, 0.031286836, -0.030661216, -0.049523607, -0.04345009, 0.050160203, 0.051760755, -0.00044032233, -0.022693455, 2.2239176e-06, -0.025638381, -0.027667375, -0.024865547, -0.020249033, 0.06249315, 0.05705409, 0.082771994, -0.016871836, 0.019698562, -0.012230186, 0.08110379, 0.0007376958, 0.07859291, -0.045246206, 0.018310152, 0.012782802, -0.039828576, -0.0807929, -0.0030020326, -0.06451831, -0.033646002, -0.016777286, -0.007246607, -0.06631807, -0.06786792, -0.029850464, 0.023332553, -0.020112857, -0.027359774, 0.015749892, 0.026440058, 0.004316677, -0.016152514, 0.014283761, 0.0023539846, 0.012720653, 0.019714722, 0.0022771517, 0.022872208, 0.04272981, -0.09403777, 0.026325101, -0.06133859, 0.017964575, 0.012008639, -0.05337227, 0.028812956, 0.005162937, 0.021227269, -0.02414069, -0.0049331984, -0.015390474, -0.033417158, 0.018182397, 0.05719931, 0.06089245, -0.042624775, -0.038147517, -0.022986516, -0.032915052, 0.02530182, 0.043176923