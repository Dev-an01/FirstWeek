9076, -0.009199452, -0.04345317, 0.031183915, 0.010264302, 0.031126324, -0.030528562, 0.06291884, -0.019406384, -0.0013476154, 0.0073883077, 0.0017814479, -0.0412895, 0.047262188, 0.021230523, 0.019594692, 0.105062775, 0.0060556433, 0.037119064, 0.023267688, -0.0991711, 0.016834503, -0.045307335, 0.013758011, 0.07115465, -0.013186554, 0.007262428, 0.009919221, 0.014682231, 0.038221147, -0.00040370302, -0.008922961, -0.03583936, 0.00023005165, -0.050568487, 0.03516528, 0.039046418, 0.061190594, -0.011021367, 0.01579328, -0.07661052, 0.028696043, 0.019727165, 0.031049976, 0.102958605, 0.06079416, 2.3096226e-34, -0.03247293, -0.08834493, -0.022980493, 0.010310673, -0.036139634, 0.012396188, 0.015123922, -0.022477513, -0.016880104, -0.0034562554, -0.010070128], embedding_text: 'Policy: Code of Conduct\nVersion: None\nID: POLICY-HR-004\n\nContent:\n# Code of Conduct\n\n**Document ID**: POLICY-HR-004  \n**Version**: 1.1  \n**Effective Date**: January 1, 2024  \n**Owner**: CEO (Akiko Tanaka) + People Operations  \n**Last Updated**: January 1, 2024  \n**Review Frequency**: Annually  \n**Confidentiality**: Public (also applies to contractors, vendors on-site)\n\n---\n\n## 1. Purpose\n\nThis Code of Conduct establishes behavioral and ethical standards for everyone at NexaTech to:\n- Create respectful, inclusive workplace\n- Uphold company values\n- Comply with laws and regulations\n- Protect company reputation\n- Guide ethical decision-making\n\n---\n\n## 2. Scope\n\nApplies to:\n- All employees (full-time, part-time, contract)\n- Board members and advisors\n- Vendors and partners (when on NexaTech premises or representing company)\n\nApplies during:\n- Work hours and company events\n- Business travel\n- Client interactions\n- Online/social media (when representing company)\n\n---\n\n## 3. Our Values\n\nNexaTech is guided by core values that shape our behavior:\n\n### 3.1 Customer First\n- Put customer needs at center of decisions\n- Deliver exceptional value\n- Act with integrity in customer relationships\n\n### 3.2 Radical Transparency\n- Communicate openly and honestly\n- Share information proactively\n- Admit mistakes and learn from them\n\n### 3.3 Sustainable Growth\n- Balance short-term results with long-term health\n- Invest in people and capabilities\n- Build for the long term\n\n### 3.4 Team Collaboration\n- Work together across functions\n- Share knowledge freely\n- Support each other\'s success\n\n### 3.5 Continuous Learning\n- Stay curious and open-minded\n- Experiment and iterate\n- Grow through feedback\n\n**Reference**: CEO Akiko\'s decision cases (DC_AKIKO_001-005) demonstrate these values in practice\n\n---\n\n## 4. Professional Conduct\n\n### 4.1 Respect and Dignity\n\n**We commit to**:\n- ✓ Treat everyone with respect regardless of position\n- ✓ Listen actively and consider diverse perspectives\n- ✓ Assume positive intent\n- ✓ Give constructive feedback professionally\n- ✓ Celebrate others\' successes\n\n**We do NOT tolerate**:\n- ❌ Harassment or discrimination (see Section 5)\n- ❌ Bullying or intimidation\n- ❌ Public humiliation or shaming\n- ❌ Retaliation against those who speak up\n- ❌ Gossip or undermining colleagues\n\n### 4.2 Professionalism\n\n**Expected behaviors**:\n- Be punctual for meetings\n- Respond to communications timely\n- Meet commitments and deadlines\n- Dress appropriately for context (casual office, business for clients)\n- Maintain appropriate boundaries\n\n**Unacceptable behaviors**:\n- Chronic lateness without communication\n- Ghosting colleagues or customers\n- Inappropriate language or jokes\n- Unprofessional social media posts about company\n\n### 4.3 Communication Standards\n\n**In all communication**:\n- Be clear and concise\n- Be respectful in tone\n- Avoid ALL CAPS (shouting)\n- Use inclusive language\n- Consider cultural differences\n- Disagree constructively\n\n**Email/Slack etiquette**:\n- Reply within 24 hours (business days)\n- Use "Reply All" judiciously\n- No sensitive topics in group channels\n- Respect working hours (use scheduled send)\n\n---\n\n## 5. Anti-Harassment and Anti-Discrimination\n\n### 5.1 Zero Tolerance Policy\n\nNexaTech has **zero tolerance** for:\n- Harassment (sexual, verbal, physical, visual)\n- Discrimination based on protected characteristics\n- Retaliation against those who report\n\n**Consequences**: Immediate investigation, up to and including termination\n\n### 5.2 Protected Characteristics\n\n**We do NOT discriminate based on**:\n- Race, color, ethnicity, national origin\n- Gender, gender identity, gender expression\n- Sexual orientation\n- Age\n- Religion or belief\n- Disability (physical or mental)\n- Marital or family status\n- Pregnancy or parental status\n- Political affiliation\n- Any other characteristic protected by law\n\n### 5.3 Sexual Harassment\n\n**Prohibited behaviors**:\n- Unwelcome sexual advances or propositions\n- Requests for sexual favors\n- Sexual comments, jokes, or innuendo\n- Sharing sexual images or content\n- Unwanted physical contact\n- Creating hostile work environment\n\n**Applies to**:\n- Supervisor-employee relationships\n- Peer-to-peer interactions\n- Vendor/customer interactions\n- Online and in-person\n\n### 5.4 Other Forms of Harassment\n\n**Also prohibited**:\n- Verbal harassment (insults, slurs, threats)\n- Physical harassment (unwanted touching, blocking)\n- Visual harassment (offensive images, gestures)\n- Cyberbullying (online harassment)\n- Microaggressions (subtle discrimination)\n\n### 5.5 Romantic Relationships\n\n**Supervisor-subordinate relationships**: Prohibited due to power dynamics\n\n**Peer relationships**: Allowed but must be disclosed to HR\n- Maintain professionalism at work\n- No favoritism\n- If relationship ends, maintain professionalism\n\n**Client relationships**: Strongly discouraged (conflicts of interest)\n\n---\n\n## 6. Diversity, Equity, and Inclusion\n\n### 6.1 Commitment\n\nNexaTech is committed to:\n- Diverse workforce reflecting society\n- Equitable opportunities for all\n- Inclusive culture where everyone belongs\n\n### 6.2 Inclusive Behaviors\n\n**Practice**:\n- Use people\'s preferred names and pronouns\n- Be mindful of cultural holidays and practices\n- Ensure meetings are accessible (captions, breaks)\n- Invite diverse perspectives\n- Challenge bias when you see it\n\n**Avoid**:\n- Assumptions based on appearance\n- Cultural appropriation\n- Tokenism ("representing your group")\n- Microaggressions\n\n### 6.3 Accommodations\n\n**We provide** reasonable accommodations for:\n- Disabilities (physical, mental, cognitive)\n- Religious practices\n- Family/caregiving needs\n- Other situations requiring flexibility\n\n**Process**: Contact HR confidentially (people@nexatech.jp)\n\n---\n\n## 7. Conflicts of Interest\n\n### 7.1 Definition\n\n**Conflict of interest**: When personal interests could improperly influence business decisions\n\n### 7.2 Common Examples\n\n**Must disclose**:\n- Financial interest in vendor/customer/competitor\n- Family member works at vendor/customer/competitor\n- Outside employment or board positions\n- Personal relationship with vendor contact\n- Receiving gifts >¥10,000 from vendor\n\n### 7.3 Disclosure Process\n\n**How to disclose**:\n1. Email HR and your manager\n2. Describe the potential conflict\n3. Proposed mitigation (e.g., recuse from decision)\n4. HR documents and advises\n\n**Not penalty**: Disclosure is responsible, concealment is violation\n\n### 7.4 Outside Activities\n\n**Allowed with disclosure**:\n- Side businesses (not competing with NexaTech)\n- Board positions (not competing)\n- Consulting work (limited hours, no IP conflicts)\n\n**Requires approval**:\n- Any outside work >10 hours/week\n- Any work in related industry\n- Any use of NexaTech resources\n\n**Prohibited**:\n- Competing directly with NexaTech\n- Using company time for outside work\n- Using confidential info for personal gain\n\n---\n\n## 8. Confidentiality and Information Security\n\n### 8.1 Confidential Information\n\n**Must protect**:\n- Customer data (names, usage, content)\n- Employee data (salaries, reviews, personal info)\n- Company financials and strategy\n- Product roadmaps and IP\n- Trade secrets and proprietary methods\n\n**See**: Information Security Policy (POLICY-IT-001) for full requirements\n\n### 8.2 Social Media\n\n**Personal social media**:\n- ✓ Can share public company news\n- ✓ Can express personal opinions (with disclaimer)\n- ✓ Be respectful and professional\n\n**Prohibited**:\n- ❌ Sharing confidential information\n- ❌ Speaking on behalf of company (unless authorized)\n- ❌ Disparaging company, colleagues, customers\n- ❌ Harassment or discrimination online\n\n**Guideline**: Would you say it in front of your CEO? If not, don\'t post it.\n\n### 8.3 Media and Public Speaking\n\n**Media inquiries**:\n- Refer to CMO or CEO\n- Don\'t speak on company\'s behalf unless authorized\n\n**Public speaking** about company:\n- Get approval from manager + CMO\n- Use approved messaging\n- Make clear if personal views\n\n---\n\n## 9. Protecting Company Assets\n\n### 9.1 Physical Assets\n\n**Proper use of**:\n- Company equipment (laptops, phones, etc.)\n- O\n\n[Content truncated due to length...]', category: 'People'});
CREATE (n44:Policy {file_path: 'test_data/policies/hiring_approval_policy.md', last_updated: neo4j.time.Date(2024, 2, 1), confidentiality: 'Internal', embedding_model: 'sentence-transformers/all-mpnet-base-v2', owner_executive: 'Raj Patel', review_frequency: 'Annually', version: '1.2', embedding_date: neo4j.time.DateTime(2025, 10, 24, 4, 45, 3, 220000000, tzinfo=<UTC>), embedding_dimensions: 768, name: 'Hiring Approval Policy', effective_date: neo4j.time.Date(2024, 2, 1), id: 'POLICY-HR-005', embedding: [0.027411154, 0.01630595, 0.00034949768, -0.048353113, 0.027508533, 0.025971217, -0.006093325, 0.07407992, -0.01655964, 0.0077938573, 0.014157021, -0.023938175, 0.033243507, 0.027217489, -0.06470594, 0.027130257, 0.0067738937, 0.0428945, -0.014488931, -0.008836851, -0.021762637, 0.010664444, -0.025759958, 0.038520325, -0.010640186, -0.0045228833, 0.07258352, -0.030084401, -0.0077138627, -0.010996404, 0.012766993, 0.0136807775, 0.0033717991, -0.056658722, 2.2040558e-06, -0.019623727, -0.0030541527, -0.0041867224, 0.0055219, 0.019222522, -0.008379809, -0.074006654, -0.032541897, 0.029593594, 0.00370222, 0.00277054, -0.018823905, 0.056014914, 0.042566147, -0.0012899797, 0.0005362947, -0.06826998, -0.08788216, -0.05810261, -0.0037118534, -0.056294918, 0.012745906, -0.06343493, -0.038168907, -0.033086877, -0.011778038, -0.03548301, 0.0031513385, -0.027544098, 0.0034360501, 0.024473283, 0.08582257, -0.07872781, 0.060110345, 0.039478872, 0.098300405, 0.004521887, 0.009653636, 0.021446586, 0.022050466, -0.013439145, 0.004223414, 0.022266798, -0.026607325, -0.04774484, 0.0039720493, 0.05799479, -0.019965196, -0.055629604, 0.02720521, 0.062160127, -0.018503195, -0.037019987, 0.0037748052, -0.017803308, 0.069895595, -0.0031800787, -0.014228412, 0.033628024, -0.01664998, -0.0061003226, 0.03403215, 0.03405492, 0.035760432, -0.013298028, -0.004806903, 0.028297618, 0.010763428, 0.051548477, 0.0115052, 0.019044865, -0.045779526, -0.011089347, -0.012766916, 0.021600122, 0.027399318, 