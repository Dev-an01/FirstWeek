1, 0.04756177, -0.07804662, -0.009097462, 0.010519629, -0.017764427, -0.019736424, -0.07362957, 0.015626002, 0.0042476454, 0.001522084, 0.0389466, 0.043566994, 0.025923995, 0.039917808, -0.018276395, 0.0052117063, -0.0022432387, -0.047911737, 0.015879331, 0.045807626, 0.014608519, 0.015925016, 0.022477226, 0.009243293, 0.03359891, 0.037497994, -0.026196579, 0.016468799, -0.034894053, -0.013757616, -0.08893713, 0.00045312, 0.00025180276, -0.06949862, -0.046137694, -0.039567363, -0.011212283, -0.035335556, -0.026075067, 0.016809193, 0.035974946, -0.010458866, -0.043902256, 0.041794434, 0.006397331, 0.006778553, 0.022310372, -0.04405013, 0.022103023, -0.0041001677, 0.08717046, -0.022767622, -0.022260172, -0.010788668, -0.054885995, -0.082162365, -0.02485013, -0.009094098, 0.012512908, 0.015323053, -0.021090835, -0.029558454, -0.02839144, 0.020948555, 0.06202443, 0.0153677445, -0.027250197, 0.030817538, 0.013903711, -0.05899644, -0.0029894211, -0.0052436343, -0.05178597, 0.010101984, 0.040257145, 0.024044992, 0.07026415, -0.03806344, -0.0024017307, -0.01009112, -0.019370949, 0.0014062996, -0.03292067, 0.0048640734, -0.010179451, 0.032542236, 0.0077564544, 0.0063987, -0.011814987, -0.03245091, -0.0075516556, 0.08555555, 0.03438706, 0.02158559, 0.0019006637, 0.023864346, -0.052385483, -0.12206128, -0.015759556, -0.017014151, 0.0007957829, 0.03948709, -0.023682741, -0.0037961458, -0.024983475, -0.025134675, 0.024705624, 0.02453906, -0.021501273, 0.005130493, -0.011223063, -0.036701757, 0.0019838682, 0.018403001, -0.017844861, 0.05545557, 0.013416601, -0.02224297, 0.027173905, 0.03178385, -0.008319194, -0.0032335469, 0.024856579, 0.0016076838, 0.02122942, -0.0082049575, -0.06431739, 0.024362318, 0.008576559, 2.915988e-07, -0.026045226, -0.0038671668, -0.018240076, 0.0033602347, 0.05221561, -0.02199371, -0.025407739, 0.018054865, 0.032179452, 0.058117304, 0.058179677, -0.024424031, -0.0072027585, -0.00874636, 0.0025228383, -0.08378978, 0.05092706, -0.040589318, -0.056841582, 0.031926356, 0.10357665, 0.016469838, 0.022026615, -0.03590059, 0.014151514, 0.007225633, 0.018061213, 0.0551342, 0.04836763, 0.02236426, 0.042806726, 0.05272147, -0.023955628, 0.026078356, 0.009427376, -0.0050164824, 0.019783646, 0.089423925, -0.018741624, 0.09259112, 0.025024554, -0.015626082, -0.006688326, -0.016244842, 0.029778013, 0.0332449, 0.010926507, 0.049542937, -0.07266046, 0.0022316403, 0.0113393385, 0.03362508, 0.0021188743, -0.01145181, 0.0036869468, -0.028597405, -0.018890189, 0.041829556, 0.055787202, 0.043149535, 0.0071326084, -0.054730322, 0.017230147, 0.024989042, 0.049445335, 0.046876326, 0.026052874, 2.6239578e-34, -0.047270846, -0.06540929, -0.025975, -0.033636995, -0.036135826, -0.007958498, 0.048359465, -0.01587476, 0.0027695321, 0.032258216, -0.03445993], embedding_text: 'Policy: Professional Development Policy\nVersion: None\nID: POLICY-HR-003\n\nContent:\n# Professional Development Policy\n\n**Document ID**: POLICY-HR-003  \n**Version**: 1.2  \n**Effective Date**: July 1, 2024  \n**Owner**: People Operations (Head of People)  \n**Last Updated**: July 1, 2024  \n**Review Frequency**: Annually  \n**Confidentiality**: Internal\n\n---\n\n## 1. Purpose\n\nThis policy establishes professional development opportunities to:\n- Support employee career growth and skill development\n- Retain top talent through learning investments\n- Build organizational capabilities\n- Promote continuous learning culture\n- Provide clear career paths (IC and management tracks)\n\n**Context**: This policy was enhanced following DC_AKIKO_003 (career development program implementation after VP Engineering departure)\n\n---\n\n## 2. Scope\n\nApplies to all NexaTech employees after completing probationary period (3 months)\n\n---\n\n## 3. Philosophy\n\nNexaTech believes:\n- **Employees own their careers**: We provide resources and support, you drive your development\n- **Learning is continuous**: Not just formal training, but daily learning opportunities\n- **Multiple paths to growth**: Individual contributor (IC) and management tracks both valued\n- **Investment in people**: Development budget is investment, not expense\n\n---\n\n## 4. Learning Budget\n\n### 4.1 Annual Budget Per Employee\n\n| Employee Level | Annual Budget (¥) | Examples |\n|----------------|------------------|----------|\n| Individual Contributor | 150,000 | Conferences, courses, books |\n| Senior IC / Manager | 250,000 | Advanced training, certifications |\n| Director / VP | 400,000 | Executive coaching, leadership programs |\n| C-Level | 600,000 | Executive education, advisory boards |\n\n**Note**: Budget is per calendar year, does not roll over\n\n### 4.2 What Budget Covers\n\n**Eligible expenses**:\n- ✓ Conferences and professional events\n- ✓ Online courses (Udemy, Coursera, Pluralsight, etc.)\n- ✓ Professional certifications (PMP, AWS, CISSP, CPA, etc.)\n- ✓ Books and learning materials\n- ✓ Coaching and mentorship (external)\n- ✓ Professional membership fees\n- ✓ Workshops and bootcamps\n- ✓ Language learning (business-relevant)\n- ✓ Industry research subscriptions\n\n**Not covered**:\n- ❌ Degree programs (see Section 5)\n- ❌ Personal hobbies unrelated to work\n- ❌ Team building events (separate budget)\n- ❌ Standard work tools/software\n\n### 4.3 Budget Approval\n\n**Approval required**:\n- <¥50K: Manager approval\n- ¥50K-150K: Manager + Department Head\n- >¥150K: Manager + Head of People\n\n**Process**:\n1. Discuss with manager (align with development goals)\n2. Submit request via HR system\n3. Include: What, why, how it helps role/career\n4. Approval within 3 business days\n\n---\n\n## 5. Formal Education Support\n\n### 5.1 Degree Programs (MBA, MS, etc.)\n\n**Eligibility**:\n- 2+ years at NexaTech\n- Strong performance (Meets/Exceeds Expectations)\n- Degree relevant to current or target role\n- Commitment to stay 2 years post-completion\n\n**Support**:\n- Tuition reimbursement: Up to ¥2,000,000 over 2 years\n- Flexible schedule for classes (with manager approval)\n- Study leave: Up to 5 days/year\n\n**Application process**:\n1. Submit proposal to manager and Head of People\n2. Include: Program details, relevance to role, commitment plan\n3. Decision within 30 days\n4. Sign education agreement (repayment terms if leave early)\n\n**Repayment**:\n- Leave within 1 year of completion: 100% repayment\n- Leave within 2 years of completion: 50% repayment\n- Stay 2+ years: No repayment\n\n### 5.2 Professional Certifications\n\n**Fully covered** (no budget limit) for job-relevant certifications:\n\n**Engineering**:\n- AWS Certified Solutions Architect\n- Google Cloud Professional\n- Kubernetes certifications (CKA, CKAD)\n- Security certifications (CISSP, CEH)\n\n**Product/Design**:\n- Certified Scrum Product Owner (CSPO)\n- Pragmatic Marketing Certified\n- UX certifications\n\n**Sales/Marketing**:\n- Salesforce certifications\n- HubSpot certifications\n- Google Analytics certification\n\n**Finance**:\n- CPA, CFA (study materials + exam fees)\n- FP&A certifications\n\n**Process**:\n- Discuss with manager\n- Company pays for exam + study materials\n- Receive bonus upon passing (¥100K for major certs)\n- Must pass within 2 attempts\n\n---\n\n## 6. Career Paths and Frameworks\n\n### 6.1 Dual Career Tracks\n\n**Individual Contributor (IC) Track**:\n- Junior → Mid → Senior → Staff → Principal\n- Technical/domain expertise deepens\n- Influence through expertise, not management\n\n**Management Track**:\n- Manager → Senior Manager → Director → VP → C-Level\n- Leadership and people management\n- Influence through team building\n\n**Compensation**: Both tracks have equivalent compensation at same levels\n\n**Example (Engineering)**:\n- IC: Junior Engineer → Engineer → Senior Engineer → Staff Engineer → Principal Engineer\n- Management: Engineering Manager → Senior EM → Director of Engineering → VP Engineering → CTO\n\n### 6.2 Career Frameworks\n\n**Each role has defined**:\n- Core competencies required\n- Expected impact and scope\n- Promotion criteria\n- Typical timeline (but not rigid)\n\n**Frameworks available**: [Internal career site]\n\n**Example - Engineer to Senior Engineer**:\n- **Technical skills**: Master 2+ tech stacks, system design, code review\n- **Impact**: Lead medium projects, mentor 2+ juniors\n- **Collaboration**: Work across teams effectively\n- **Timeline**: Typically 2-3 years\n\n### 6.3 Career Conversations\n\n**Quarterly career 1:1s** with manager:\n- Progress on current goals\n- Skills to develop\n- Career aspirations\n- Learning opportunities\n- Feedback and coaching\n\n**Annual career planning**:\n- Review past year growth\n- Set development goals for next year\n- Identify stretch assignments\n- Discuss promotion readiness\n\n**Manager responsibility**: Actively support employee development, not just evaluate performance\n\n---\n\n## 7. Internal Learning Programs\n\n### 7.1 NexaTech University (Internal Training)\n\n**Monthly workshops** on:\n- Technical skills (coding, architecture, security)\n- Product skills (user research, roadmapping)\n- Business skills (finance, strategy, communication)\n- Leadership skills (1:1s, feedback, delegation)\n\n**Lunch & Learns**:\n- Weekly sessions (Fridays 12:00-13:00)\n- Employees share expertise\n- External speakers occasionally\n\n**Engineering Reading Group**:\n- Monthly book club\n- Technical books (company provides)\n- Discussion and application\n\n### 7.2 Mentorship Program\n\n**Formal mentorship** (6-month cohorts):\n- Mentee applies with goals\n- Matched with mentor (different team)\n- Monthly 1-hour meetings\n- Structured curriculum + free-form\n\n**Mentor eligibility**:\n- Senior+ level\n- Strong performer\n- Voluntarily participates\n\n**Mentee benefits**:\n- Career guidance\n- Network expansion\n- Learning from experience\n- Confidential sounding board\n\n### 7.3 Job Shadowing\n\n**Shadow other roles** to:\n- Understand cross-functional work\n- Explore career pivots\n- Build empathy\n\n**Process**:\n- Request via HR system\n- Manager approval\n- 2-5 days shadowing\n- Reflection write-up\n\n**Popular**:\n- Engineers shadowing Product/Design\n- Marketing shadowing Sales\n- Sales shadowing Customer Success\n\n---\n\n## 8. Conference and Event Attendance\n\n### 8.1 Conference Budget\n\n**Included in development budget** (Section 4.1)\n\n**Popular conferences**:\n- **Tech**: AWS re:Invent, Google Cloud Next, KubeCon\n- **Product**: ProductCon, Mind the Product\n- **Sales**: SaaStr Annual\n- **Marketing**: HubSpot INBOUND\n- **General**: Tech conferences in Tokyo/Osaka\n\n### 8.2 Conference Approval Process\n\n**To attend conference**:\n1. Submit 30 days in advance (or as soon as announced)\n2. Include: Event details, cost, learning objectives\n3. Manager approval\n4. Book travel per Travel Policy (POLICY-FIN-004)\n\n**Company expectations**:\n- Attend sessions (not just networking)\n- Share learnings with team (presentation or write-up)\n- Network and represent company professionally\n\n### 8.3 Speaking at Conferences\n\n**Encouraged!** Great visibility for company\n\n**Support provided**:\n- Travel fully covered (outside development budget)\n- Time to prepare (work time)\n- Slide templat\n\n[Content truncated due to length...]', category: 'People'});
CREATE (n41:Policy {file_path: 'test_data/policies/time_off_policy.md', last_updated: neo4j.time.Date(2024, 4, 1), confidentiality: 'Internal', embedding_model: 'sentence-transformers/all-mpnet-base-v2', owner_executive: 'Akiko Tanaka', review_frequency: 'Annually', version: '2.1', embedding_date: neo4j.time.DateTime(2025, 10, 24, 4, 45, 3, 194000000, tzinfo=<UTC>), embedding_dimensions: 768, name: 'Time Off Policy', effective_date: neo4j.time.Date(2024, 4, 1), id: 'POLICY-HR-002', embedding: [0.02083698, 0.01546399, -0.03514675, -0.0070281094, 0.025138702, 0.04845946, 0.037990015, 0.09731797, -0.094201125, -0.00811117, 0.034772806, 0.017787464, 0.0119944215, 0.04212827, -0.028994523, -0.049765512, -0.014375351, 0.017979447, 0.028542213, -0.00745639, -0.018418435, 0.005200595, -0.030981991, 0.032976665, 0.028056243, -0.0068798605, 0.06329118, -0.0011843465, 0.018697258, -0.004671312, 0.047624294, -0.009230475, -0.00092918833, -0.02183431, 2.1213411e-06, -0.014595443, -0.026552513, 0.035555623, 0.034162235, 0.043570682, -0.04239805, -0.036093, -0.0021252844, 0.02697267, 0.027918674, 0.010364282, -0.020472907, 0.00787235, 0.025488785, 0.032536007, -0.020730197, 0.0045846337, -0.07223047, -0.015511198, 0.030250713, -0.023485463, -0.02946502, -0.065729976, -0.022177113, -0.051305674, 0.062043384, -0.039453868, 0.03342085, -0.008442149, 0.03163738, 0.04314656, 0.053201184, -0.04762645, 0.06441412, 0.004196927, 0.076863274, 0.006351716, 0.043102898, 0.026822545, -0.026274119, -0.022155337, 0.0054234266, 0.011745454, 0.011292495, -0.068262726, 0.083412506, 0.087990835, -0.039908092, -0.047352843, -0.0004803693, 0.039156377, 0.014415593, -0.012524612, -0.0011396022, -0.027452447, 0.04228037, -0.014888326, 0.00079905556, 0.060120028, 0.026220609, -0.01023555, 0.0034280112, 0.027465552, 0.026004253, 0.00230694, -0.0148341125, 0.028706728, -0.00428272, 0.010011904, 0.04439969, 0.013165431, -0.07290193, -0.015417965, 0.0016917746, 0.013415783, 0.010669974, 0.009558968, -0.01235