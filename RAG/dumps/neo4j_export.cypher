3, 0.04253588, 0.099071205, 0.004375427, 0.009330702, 0.054763187, -0.013328719, -0.009867228, -6.147055e-33, 0.026697954, -0.05332611, -0.0037989742, -0.03096064, -0.027040081, 0.053679164, -0.016671333, 0.0066480064, -0.0044377986, -0.009148445, -0.0586682, 0.027105678, 0.023423614, -0.00032214928, 0.048837315, -0.0051711067, -0.040900443, 0.015271976, -0.021202644, -0.00443849, 0.025103115, -0.0016947846, 0.021703184, -0.060944207, -0.015177902, 0.0891267, 0.0062505146, -0.013163945, -0.039330132, -0.01782953, 0.023486052, 0.01885232, 0.002455351, -0.08895307, 0.024230128, 0.016592711, 0.008040248, -0.010740293, -0.011690008, -0.045751296, 0.0011553587, 0.0048449836, 0.013663162, 0.033408377, 0.008798522, -0.019365506, -0.026179558, -0.002156857, -0.014451958, -0.01555837, -0.06184106, 0.03216203, -0.05537756, 0.057073407, -0.009003017, 0.0026541513, -0.030094419, 0.06581043, -0.06581024, -0.020016512, -0.0021789686, -0.08533581, 0.011813026, -0.035157733, -0.017914446, 0.01855667, -0.06729033, 0.043159936, -0.042187776, -0.035449576, -0.020373974, 0.05622255, -0.051881723, 0.005384412, -0.027182566, -0.08836979, -0.02230353, 0.044495147, 0.022969222, 0.05468186, 0.02275241, 0.0062434976, -0.048447862, -0.010566143, 0.045924023, -0.00095837045, -0.029937744, 0.031035705, -0.008265135, -0.00626366, 0.01565005, 0.02781867, 0.017699672, 0.05081591, 0.01821972, -0.030587256, 0.05278012, 0.028431304, 0.018551977, 0.023336561, 0.0033378, -0.019319143, 0.011377024, 0.03909667, -0.0047510266, -0.034180272, -0.0133188665, -0.00076612475, 0.027271705, 0.044319887, 0.0013343456, 0.009928763, -0.020042572, 0.023701511, -0.03092494, 0.05007152, 0.015012656, -0.072727576, 0.047885858, 0.04813523, 0.025100712, -0.025091143, -0.0063602026, -0.019219015, 0.016988084, 0.042847123, 0.05889404, -0.008344028, -0.0047038053, 0.019566394, 0.037311584, 0.007114292, 3.078498e-07, 0.012196449, -0.045244362, -0.028748758, 0.0019188194, 0.010870056, 0.008764546, -0.012725509, 0.012952366, 0.070696324, -0.029339885, 0.12524146, -0.07338132, -0.029122634, -0.017904773, 0.036314026, -0.03475999, 0.028741669, -0.03154752, -0.02643872, -0.021274872, 0.11191102, 0.016688459, -0.0018556021, -0.042563967, -0.008647959, 0.076510385, 0.027432507, -0.07881936, 0.007821017, -0.018687548, 0.098454244, -0.026427662, 0.001272285, -0.0043904674, 0.0101510845, -0.008107704, -0.011798569, 0.025715524, 0.012229887, 0.0194892, 0.009400828, -0.03399997, 0.04688703, 0.010486756, 0.010104735, -0.033631053, -0.06668672, 0.03883633, -0.05105969, 0.019508012, 0.029503405, 0.036288843, -0.045872156, 0.034589976, -0.0295252, -0.0032283703, 0.033947095, -0.023370812, 0.044456325, 0.098287165, -0.047633924, 0.030052884, 0.020363243, -0.0032185188, 0.04124455, 0.0027872985, 0.0026903863, 2.8130574e-34, -0.0077695027, -0.05918896, 0.010364649, -0.01080569, -0.014405927, 0.04762476, 0.04812267, -0.019978907, -0.005165786, -0.032228522, 0.0020728067], embedding_text: "Decision Case: Untitled Decision\nDecision ID: exec_001_test_DEC_005\nExecutive: exec_001_test\nCategory: crisis_management\nDate: 2024-08-30\n\nSituation:\nAt 2 AM on Friday, our on-call engineer paged CTO about critical production issue: data export feature in WorkFlow Pro was failing for all customers. By 8 AM, we had 120 enterprise customers unable to export their project data (critical for their weekly reports). Customer success phones were overwhelmed, social media had 15 complaints (growing), and 3 major accounts threatened to escalate to their legal teams about contract violations (our SLA promises 99.9% uptime for core features). Engineering team identified root cause: database migration executed Wednesday night had a subtle bug affecting export queries. The fix requires rolling back the migration, but that needs a 24-hour maintenance window during business hours to do safely. CTO strongly recommended against rushed fix: 'If we patch this quickly, we risk making it worse and creating data corruption. We need the full 24-hour window to rollback and verify data integrity.' VP Customer Success wanted immediate emergency fix: 'We're losing customers right now. Every hour increases churn risk. Some customers are in middle of board presentations.' Sales VP concerned about deals in pipeline: 'Three major prospects evaluating us this week, this is terrible timing.' Our head of communications worried about brand damage: 'Social media sentiment turning negative fast, we need to get ahead of this.' Our SLA technically allows up to 48 hours to restore features but customers expect immediate fixes.\n\nDecision Made:\nOption 2 (Proper 24-hour maintenance) with comprehensive communication and compensation plan: (1) Immediately sent personal apology email from me to every affected customer, taking full responsibility. (2) Announced 24-hour maintenance window starting 6 PM Friday, ending 6 PM Saturday. (3) Credited all 120 affected customers with 1 month of service (total cost ¥900K). (4) Assigned dedicated CSM to each enterprise customer for duration of fix. (5) Published detailed public post-mortem on our blog explaining what happened, why we chose 24-hour fix, and what we're doing to prevent recurrence. (6) Had VP Customer Success personally call the 3 customers with legal threats to apologize and explain. (7) Provided hourly update emails during maintenance. (8) Added engineering team member to comms team to handle technical questions on social media. CTO led the maintenance, I stayed online throughout to address escalations.\n\nRationale:\nRushed engineering fixes create more problems. Here's my thinking: (1) Trust Technical Expertise - CTO said 24 hours is safe, 6 hours is risky. I trust them. Betting on rushed fix could corrupt customer data, which is catastrophic vs 24 hours of broken export. (2) Radical Transparency - Be honest about problem and timeline. Customers respect honesty more than false promises. Post-mortem builds trust. (3) Make Customers Whole - ¥900K in credits is real money but it's right thing to do. Shows we value their time and frustration. (4) Communication Over Speed - Hourly updates, personal calls, dedicated CSMs show we're taking it seriously even during fix. (5) Long-term Trust - Doing the fix right preserves trust. Rushing and creating data corruption would be unforgivable. This aligns with Operational Excellence (do it right), Radical Transparency (be honest), and Customer Success First (protect their data above all). Some executives wanted faster fix but I overruled them - this is when CEO must decide. The ¥900K credit cost is less than cost of losing even 2 customers or creating data corruption crisis.\n\nOutcome:\nSUCCESS - Maintenance completed in 23 hours (1 hour ahead of schedule). Zero customers churned from this incident. Social media sentiment actually turned positive - multiple tweets praising our transparency and handling. Customer success NPS increased by 3 points in month after incident (not a typo - went up not down). Post-mortem blog post got 15K views and was shared by industry analysts as 'example of crisis management done right.' The ¥900K credit cost was offset by PR value and churn prevention (estimated we would have lost ¥8M ARR if we'd lost 5-10 customers). Legal threats withdrawn after personal calls. The 3 deals in pipeline all closed - prospects cited our transparent handling as confidence builder. Competitors tried to use incident for FUD but it backfired because our response was so well-received. Engineering team felt supported by decision to do it right. Six months later, customers still reference this incident positively in renewal conversations. Board initially nervous about ¥900K cost but praised outcome. This is now our template for crisis management.\n\nLessons Learned:\nTransparency in crisis builds more trust than hiding or minimizing. Customers forgive honest mistakes if you make them whole. Taking time to fix properly beats rushing and risking worse problems. Post-mortems are incredibly valuable for positioning and trust. Communication during crisis matters as much as fix itself. The ¥900K 'cost' was actually investment in trust. Team felt supported when I backed CTO's recommendation over pressure for quick fix. Crisis can actually strengthen customer relationships if handled right. Our competitors' rushed fixes to similar incidents created worse problems - we were right to be patient. This incident is now used in onboarding to show our values in action.\n\nConfidence: 0.90\nPrecedent: No", category: 'strategic_financing', decision_made: 'Recommended deferring Series C to Q4 2024/Q1 2025, raise from strength', outcome: 'PENDING'});
CREATE (n16:Decision {date: neo4j.time.Date(2024, 2, 15), executive_id: 'exec_002_test', confidence: 0.82, embedding_model: 'sentence-transformers/all-mpnet-base-v2', executive_name: 'Raj Patel', title: 'Sales Team Expansion - Phased Approach', financial_impact: 18000000.0, embedding_date: neo4j.time.DateTime(2025, 10, 24, 4, 45, 2, 996000000, tzinfo=<UTC>), rationale_summary: 'Balance growth ambition with financial discipline. Prove productivity with first cohort before expanding further.', embedding_dimensions: 768, precedent: True, lessons_learned: 'Phased approaches reduce risk. Performance gates ensure accountability.', id: 'exec_002_test_DEC_001', embedding: [0.026251815, 0.074113294, 0.0038576566, 0.0052316366, 0.015080751, 0.015853712, -0.0792187, 0.0293398, -0.055858966, 0.0002455485, 0.009617524, 0.031335756, 0.0029371574, 0.034650773, -0.058930922, 0.052258123, 0.014418592, 0.0144268265, 0.030482028, -0.018507745, -0.007290557, -0.0017926812, -0.009712279, -0.0081581585, 0.01567595, -0.01681768, 0.04801442, -0.028714795, -0.0317088, -0.020792952, 0.015393266, -0.006849282, 0.0060965805, -0.024046065, 1.9537763e-06, -0.04876898, -0.029312206, -0.032215647, -0.048706472, 0.10310293, -0.035583176, -0.0062025245, -0.029310348, 0.0027422209, -0.019435085, 0.02428902, -0.030799955, 0.061580185, 0.018295385, 0.025144903, 0.0061354134, -0.06085176, -0.07630428, -0.0267257, -0.053437334, -0.10666946, -0.010007572, -0.04230555, 0.0011087836, -0.0773231, -0.01978642, 0.011162952, 0.007304404, -0.073178746, -0.012772271, 0.011044143, 0.023334587, -0.021342, 0.033214625, -0.01678317, 0.07295502, 0.03271393, -0.006570097, 0.013923067, 0.041379858, -0.040835418, 0.018970553, 0.020153351, -0.018690519, -0.025432311, -0.0118475165, 0.064170614, -0.019276133, -0.006236929, 0.01122738, -0.0005273521, -0.030518744, -0.04828448, 0.0331437, 0.04896025, 0.044085886, -0.05732802, -0.00014296871, 0.051198002, -0.038400576, 0.04989311, 0.03666563, 0.03573622, -0.003973677, -0.0718