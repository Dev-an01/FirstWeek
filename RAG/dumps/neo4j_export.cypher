52, 0.037489276, -0.07133802, 0.023309322, -0.045982905, 0.019115934, 0.0130576, 0.011119473, -0.01499522, -0.019647095, 0.017678192, 0.0012189279, -0.018585468, -0.009702125, -0.004123747, -0.007736629, -0.03051579, 0.05524092, 0.05956201, 0.0542259, 0.055450704, 0.020661969, 0.017884837, -0.004050462, 0.002242704, 0.01890185, -0.018760573, -0.018516142, -0.047975082, 0.019503769, 0.03953169, -0.061450157, -0.07312224, -0.038996387, -0.0018347114, -0.025979739, -0.06417379, -0.014097622, 0.05191218, -0.0009305154, -0.073139094, -0.004367367, -0.0001635089, -0.01800909, 0.02840834, -0.052691393, 0.030036446, -0.014076378, 0.04126419, 0.023928957, -0.049355216, -0.012631896, -0.0030483075, -0.03178578, -0.01499499, 0.003496496, -0.003616074, -0.03266385, -0.03539863, 0.01874828, -0.02770704, -0.01981737, 0.06988207, 0.0053978167, -0.0055949837, 0.037837815, -0.044731908, -0.08031503, 0.02542475, 0.09299064, -0.032300964, -0.046442557, 0.03517182, -0.0062645064, 0.09734505, 0.076536484, 0.00789913, 0.017618215, 0.003536495, -0.011723619, -0.05449365, -0.02208443, -0.032163594, 0.0114621, 0.033070315, 0.015845869, -0.016915128, -0.04767225, -0.030971449, 0.03772915, 0.04373607, 0.05980459, -0.020505715, -0.00084025366, -0.07340097, -0.09258883, -0.042195372, -0.04091037, 0.00879249, 0.027217008, -0.021238351, 0.012121779, 0.0071656136, 0.009894796, 0.017788738, -0.019321997, -0.06315918, 0.026126089, 0.030318044, -0.026261643, -0.014123598, 0.032804456, 0.0035978763, 0.06390219, -0.0046116086, -0.013318534, 0.002180981, 0.0369952, -0.005363868, -0.023225993, -0.00065170886, 0.021043235, 0.028937312, -0.012173959, 0.019556474, 0.035033688, 0.014266884, 2.6401307e-07, -0.0017521224, -0.008245186, -0.040906824, -0.014850785, 0.037427768, -0.041309837, -0.0349402, -0.008924949, 0.05715759, 0.032182306, 0.07242158, -0.054600704, -0.0048028706, -0.034968384, 0.007479877, -0.05372165, 0.007775315, -0.009723299, -0.03956286, 0.0024077424, 0.075502485, 0.011995927, 0.060903955, -0.00642911, 0.03853099, 0.025294159, 0.015133822, -0.023582315, -0.03793181, -0.03042013, 0.068101406, -0.0062566935, 0.015357718, -0.03716853, 0.007190469, 0.058712132, 0.026833778, 0.10008303, -0.044950705, 0.008109939, 0.028239127, -0.04532805, -0.0014120734, -0.07163852, 0.01571099, 0.052127585, -0.040074814, 0.035812754, 0.013632427, -0.01217593, 0.03346892, 0.009265155, 0.00043200166, 0.017367527, 0.012070931, -0.0355304, -0.036776032, 0.048421044, 0.027256543, 0.029893173, -0.004852462, -0.070290014, -0.009596753, -0.015742403, 0.026796019, 0.008463837, -0.0061258418, 2.073324e-34, -0.045459975, -0.010850693, -0.059110995, -2.4207728e-05, -0.008245923, -0.005659235, 0.047545835, 0.0038719059, -0.018684924, -0.012484469, -0.018562796], embedding_text: "Policy: Time Off Policy\nVersion: None\nID: POLICY-HR-002\n\nContent:\n# Time Off Policy\n\n**Document ID**: POLICY-HR-002  \n**Version**: 2.1  \n**Effective Date**: April 1, 2024  \n**Owner**: People Operations  \n**Last Updated**: April 1, 2024  \n**Review Frequency**: Annually  \n**Confidentiality**: Internal\n\n---\n\n## 1. Purpose\n\nThis policy establishes time off benefits to:\n- Support work-life balance and well-being\n- Comply with Japan labor law\n- Provide flexibility for personal needs\n- Encourage rest and recharge\n\n---\n\n## 2. Scope\n\nApplies to all regular full-time NexaTech employees\n\n**Part-time employees**: Prorated based on working hours\n\n---\n\n## 3. Paid Time Off (PTO)\n\n### 3.1 Annual PTO Allowance\n\n**Accrual based on tenure**:\n\n| Years of Service | Annual PTO Days | Monthly Accrual |\n|-----------------|-----------------|-----------------|\n| Year 1 | 15 days | 1.25 days/month |\n| Years 2-5 | 20 days | 1.67 days/month |\n| Years 6-10 | 22 days | 1.83 days/month |\n| Years 11+ | 25 days | 2.08 days/month |\n\n**Accrual method**: Monthly on first day of month (prorated for mid-month starts)\n\n**Example**: Employee starting June 15 gets 0.63 days PTO for June (1.25 × 15/30 days)\n\n### 3.2 PTO Usage\n\n**Minimum increment**: Half day (4 hours) or full day (8 hours)\n\n**Advance notice**:\n- <3 days PTO: 1 week advance notice\n- 3-5 days PTO: 2 weeks advance notice\n- >5 days PTO: 4 weeks advance notice (for proper coverage)\n\n**Blackout periods**: None company-wide, but teams may have busy periods (discuss with manager)\n\n**Manager approval**: Required for all PTO requests\n\n### 3.3 PTO Rollover\n\n**Year-end rollover**: Maximum 5 days to next year\n\n**Unused PTO**: Forfeit after 1 year (use it or lose it)\n\n**Rationale**: Encourage employees to actually take time off\n\n### 3.4 PTO Payout\n\n**At termination**: Unused accrued PTO paid out\n\n**Cannot cash out** during employment (must use for time off)\n\n---\n\n## 4. National Holidays\n\n### 4.1 Observed Holidays\n\nNexaTech offices closed for **Japan national holidays** (~16 days/year):\n\n- New Year's Day (January 1)\n- Coming of Age Day (2nd Monday of January)\n- National Foundation Day (February 11)\n- Emperor's Birthday (February 23)\n- Vernal Equinox Day (around March 20)\n- Showa Day (April 29)\n- Constitution Memorial Day (May 3)\n- Greenery Day (May 4)\n- Children's Day (May 5)\n- Marine Day (3rd Monday of July)\n- Mountain Day (August 11)\n- Respect for the Aged Day (3rd Monday of September)\n- Autumnal Equinox Day (around September 23)\n- Sports Day (2nd Monday of October)\n- Culture Day (November 3)\n- Labor Thanksgiving Day (November 23)\n\n**Paid holidays**: Do not count against PTO\n\n**If holiday falls on weekend**: Following Monday is observed (as per Japan custom)\n\n### 4.2 Company Holidays\n\n**Year-end closure**:\n- December 29 - January 3 (offices closed)\n- Paid time off (not counted against PTO)\n\n**Summer break**:\n- 3 days in August (dates announced annually)\n- Optional - can work if prefer\n\n---\n\n## 5. Sick Leave\n\n### 5.1 Sick Leave Allowance\n\n**10 days paid sick leave** per year (separate from PTO)\n\n**Accrual**: Available from day 1 (not accrued monthly)\n\n**Rollover**: Does not roll over to next year\n\n**Medical certification**:\n- <3 days: No doctor's note required\n- ≥3 days: Doctor's note required\n- Extended illness: Doctor's note + periodic updates\n\n### 5.2 Using Sick Leave\n\n**When to use**:\n- Personal illness or injury\n- Medical appointments\n- Mental health days (no stigma)\n- Recovery from medical procedures\n\n**Notification**:\n- Contact manager ASAP (before start of workday)\n- Slack or email acceptable\n- Update team/manager on expected return\n\n**No penalty**: We trust employees, no questions asked for sick leave\n\n### 5.3 Extended Illness\n\n**If sick >10 days in year**:\n- Can use PTO for additional days\n- Or unpaid leave (see Section 9)\n- Long-term disability insurance available (if >30 days)\n\n**Serious illness**: Discuss with HR for accommodation options\n\n---\n\n## 6. Parental Leave\n\n### 6.1 Maternity Leave\n\n**Eligibility**: Pregnant employees\n\n**Duration**:\n- 6 weeks before due date (if requested)\n- 8 weeks after birth (mandatory under Japan law)\n- **Total**: Up to 14 weeks\n\n**Pay**: Full salary (100% paid by company)\n\n**Job protection**: Guaranteed return to same or equivalent role\n\n### 6.2 Paternity Leave\n\n**Eligibility**: All new fathers (including adoptive)\n\n**Duration**: 8 weeks (within 1 year of birth)\n\n**Pay**: Full salary (100% paid by company)\n\n**Flexible**: Can take continuously or split into 2 periods\n\n### 6.3 Parental Leave (Childcare Leave)\n\n**Eligibility**: All parents after maternity/paternity leave\n\n**Duration**: Up to 1 year per child (can extend to 18 months in special cases)\n\n**Pay**: \n- First 6 months: 67% of salary (government subsidy)\n- Months 7-12: 50% of salary (government subsidy)\n- Company does not top-up (follows Japan standard)\n\n**Job protection**: Guaranteed return to same or equivalent role\n\n**Flexible return**: Can return earlier or extend with manager discussion\n\n### 6.4 Adoption Leave\n\n**Same benefits** as maternity/paternity leave\n\n**Duration**: 8 weeks full-paid leave upon adoption\n\n---\n\n## 7. Bereavement Leave\n\n### 7.1 Immediate Family\n\n**Definition**: Spouse, children, parents, siblings, grandparents, grandchildren\n\n**Duration**: 5 days paid leave\n\n**Flexibility**: Can take non-consecutively within 3 months of death\n\n**Travel**: If overseas funeral, additional 2 days travel time (paid)\n\n### 7.2 Extended Family\n\n**Definition**: Aunts, uncles, cousins, in-laws\n\n**Duration**: 3 days paid leave\n\n### 7.3 Funeral Assistance\n\n**Company provides**:\n- Flowers/wreath for funeral\n- Support with arrangements (if needed)\n- Employee Assistance Program (counseling)\n\n---\n\n## 8. Other Types of Leave\n\n### 8.1 Jury Duty / Court Appearance\n\n**Pay**: Full salary (treated as work day)\n\n**Duration**: As required\n\n**Process**: Provide court summons to manager and HR\n\n### 8.2 Voting\n\n**Japan election day**: Company encourages voting\n- Flexible schedule to vote\n- Up to 2 hours paid time if needed\n\n### 8.3 Volunteer Time Off (VTO)\n\n**Annual allowance**: 2 days paid VTO\n\n**Eligible activities**:\n- Approved charitable organizations\n- Community service\n- Disaster relief\n\n**Approval**: Manager + HR (ensure organization is legitimate)\n\n**Team volunteer**: Company organizes quarterly volunteer day (separate from individual VTO)\n\n### 8.4 Education/Exam Leave\n\n**For job-relevant certifications**:\n- Up to 2 days paid leave for exam preparation\n- Exam day: Paid time off\n\n**See**: Professional Development Policy (POLICY-HR-003)\n\n---\n\n## 9. Unpaid Leave\n\n### 9.1 Personal Leave of Absence\n\n**Eligibility**: Employees with 1+ year tenure\n\n**Duration**: Up to 3 months (with manager and HR approval)\n\n**Reasons**:\n- Extended travel\n- Family care beyond parental leave\n- Personal circumstances\n- Sabbatical\n\n**Benefits during leave**:\n- Health insurance maintained (employee pays premium)\n- No salary\n- PTO does not accrue\n- Job protection (but not guaranteed same role)\n\n**Return**: 4 weeks advance notice required\n\n### 9.2 Medical Leave of Absence\n\n**Eligibility**: All employees\n\n**Duration**: Up to 6 months\n\n**Process**:\n- Doctor's certification required\n- Periodic medical updates\n- HR coordinates accommodations\n- Return-to-work clearance needed\n\n**Benefits**: Health insurance maintained (company pays)\n\n---\n\n## 10. Leave Request Process\n\n### 10.1 How to Request\n\n**PTO and planned leave**:\n1. Check team calendar for conflicts\n2. Request via HR system (BambooHR)\n3. Manager receives notification\n4. Approval within 48 hours\n5. Add to team calendar\n\n**Sick leave**:\n1. Message manager ASAP (Slack/email)\n2. Log in HR system when able\n3. No pre-approval needed\n\n**Extended leave** (parental, sabbatical):\n1. Discuss with manager (as early as possible)\n2. Submit formal request to HR\n3. HR coordinates paperwork\n4. Transition plan created\n\n### 10.2 Manager Responsibilities\n\n**Reviewing requests**:\n- Consider business needs and coverage\n- Can request alternative dates (with reason)\n- Cannot deny without valid business reason\n- Enco\n\n[Content truncated due to length...]", category: 'People'});
CREATE (n42:Policy {file_path: 'test_data/policies/expense_reimbursement_policy.md', last_updated: neo4j.time.Date(2024, 3, 1), confidentiality: 'Internal', embedding_model: 'sentence-transformers/all-mpnet-base-v2', owner_executive: 'Raj Patel', review_frequency: 'Annually', version: '1.3', embedding_date: neo4j.time.DateTime(2025, 10, 24, 4, 45, 3, 161000000, tzinfo=<UTC>), embedding_dimensions: 768, name: 'Expense Reimbursement Policy', effective_date: neo4j.time.Date(2024, 3, 1), id: 'POLICY-FIN-005', embedding: [0.048510015, 0.0039181067, -0.018784702, 0.007477811, 0.05103799, 0.030579586, 0.0029767237, 0.07730348, -0.06329597, -0.023550581, -0.007487787, 0.041288182, 0.027375769, 0.024767352, 0.02196072, 0.03761909, 0.013517617, 0.029894937, 0.022435663, 0.005174734, -0.0036042135, 0.004450664, -0.041819613, 0.0034621512, 0.016145596, 0.044313855, 0.04289303, -0.0038045899, 0.011714079, -0.037691202, 0.08236597, -0.003602761, 0.021152942, -0.060062565, 2.0079583e-06, -0.040018994, -0.012540193, -0.010639562, 0.0024617026, -0.010535836, -0.0058451756, 0.04321728, 0.0011098824, 0.036066744, 0.0022920228, -0.011627214, -0.011267138, 0.063522674, 0.0005788298, 0.040435765, -0.04018922, -0.047137525, -0.08525206, -0.0031968118, 0.0059204414, 0.001459192, -0.024915086, -0.048520107, -0.027945016, -0.027197339, 0.014336782, -0.014398871, 0.045544997, 0.00030283706, 0.052954357, 0.006469112, 0.013014936, 0.033529766, 0.014185629, 0.025463227, 0.051529445, 0.024122216, 0.021286607, 0.04509005, -0.0183657, -0.06493576, 0.03047061, 0.026081726, -0.018801035, -0.05130427, 0.060675327, 0.0490445, -0.00054662745, 0.008939814, 0.062184777, -0.013762797, 0.005963644, -0.0034595297, -0.038619187, -0.00097328034, 0.047024485, 0.041565917, -0.028815694, 0.014489047, 0.007255102, 0.02461908, 0.011468154, 0.046602357, 0.040045872, 0.044481788, 0.055273894, 0.023348868, 0.03935668, 0.0029022696, -0.0033330792, 0.010832421, -0.079598404, -0.035493556, -0.02159119, 0.013991169, 0.073