// backend/auth-service/shared/prisma/schema.prisma
generator mainClient {
  provider      = "prisma-client-js"
  output        = "../lib/generated/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"] // since we are using alpine builds, and prisma uses debian.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// User Model - Simple user information
// =============================================
model User {
  id        String @id @default(cuid())
  username  String @unique
  email     String? @unique // optional since user wont sign-up using email, they will later verify the email.
  firstName String
  lastName  String
  profilePic String?
  title      String?  // Job title/designation (e.g., "CEO", "CTO", "VP Engineering")

  // Authorization
  role      UserRole @default(EMPLOYEE)

  // Company membership (RBAC)
  companyId         String?            // FK to company (NULL for GUEST/SUPER_ADMIN)
  isCompanyVerified Boolean @default(false)  // Verified by COMPANY_ADMIN
  verifiedAt        DateTime?
  verifiedBy        String?            // User ID who verified this user

  // Authentication
  password      String
  emailVerified Boolean @default(false)
  emailVerifiedAt DateTime?
  isActive      Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?

  // Relations
  projectMemberships ProjectMember[]
  teamAssignments TeamAssignment[]
  sessions Session[]
  emailVerifications EmailVerification[]
  passwordResets PasswordReset[]
  preferences UserPreferences?
  company Company? @relation(fields: [companyId], references: [id])
  createdInviteCodes InviteCode[] @relation("InviteCodeCreator")

  // Indexes for performance
  @@index([email])
  @@index([username])
  @@index([isActive])
  @@index([createdAt])
  @@index([emailVerified])
  @@index([companyId])
  @@unique([companyId, id])
  @@index([isCompanyVerified])

  @@map("users")
}

// =============================================
// UserPreferences Model - User-specific settings for chat
// =============================================
model UserPreferences {
  id        String @id @default(cuid())
  userId    String @unique

  // RAG & AI Preferences
  defaultProfileId String? @default("exec_003_test") // Default executive AI persona
  defaultTopK      Int     @default(5)                // Default number of documents to retrieve
  defaultMinScore  Float   @default(0.15)              // Default similarity threshold

  // UI Preferences
  streamingEnabled Boolean @default(true)  // Enable word-by-word streaming
  theme            String? @default("light") // UI theme (light/dark)
  language         String? @default("en")    // Interface language

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes for performance
  @@index([userId])

  @@map("user_preferences")
}

// =============================================
// Session Model - User authentication sessions
// =============================================
model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique // FIXED: Made unique to allow findUnique queries
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Indexes for performance
  @@index([userId])
  @@index([token])
  @@index([refreshToken])
  @@index([expiresAt])
  @@index([userId, expiresAt]) // Composite index for getUserSessions queries
  
  @@map("sessions")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String

  email    String   @unique // Unique email for verification

  otp       String
  token     String?

  isVerified Boolean @default(false)
  attempts  Int @default(0) // Number of attempts for verification

  expiresAt DateTime
  createdAt DateTime @default(now())
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Indexes for performance
  @@index([userId])
  @@index([token])
  @@index([email])
  @@map("email_verifications")
}
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  email     String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  usedAt    DateTime?
  attempts  Int      @default(0)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([userId])
  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@index([isUsed])
  @@map("password_resets")
}

// =============================================
// Company Model - For multi-tenant organization
// =============================================
model Company {
  id             String   @id @default(cuid())
  name           String
  allowedDomains String[] // e.g., ["company.com", "company.co.jp"] for auto-registration
  description    String?
  website        String?
  phone          String?
  address        String?
  isActive       Boolean  @default(true)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  projects       Project[]
  teams          CompanyTeam[]
  users          User[]
  inviteCodes    InviteCode[]
  
  @@index([name])
  @@index([isActive])
  @@map("companies")
}

// =============================================
// Maintained company-shared teams; assignments never grant project membership.
// =============================================
model CompanyTeam {
  companyId String
  id String
  name String
  description String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments TeamAssignment[]

  @@id([companyId, id])
  @@unique([companyId, name])
  @@map("company_teams")
}

model TeamAssignment {
  companyId String
  teamId String
  userId String
  assignment String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team CompanyTeam @relation(fields: [companyId, teamId], references: [companyId, id], onDelete: Cascade)
  user User @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Cascade, onUpdate: Restrict)

  @@id([companyId, teamId, userId])
  @@index([companyId, userId])
  @@map("team_assignments")
}

// InviteCode Model - For employee self-registration
model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique    // The invite code string
  companyId   String                // Which company this code is for
  createdById String                // COMPANY_ADMIN or SUPER_ADMIN who created it
  
  usageLimit  Int       @default(1) // How many times can be used
  usageCount  Int       @default(0) // How many times used so far
  expiresAt   DateTime?             // Optional expiration
  isActive    Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  
  // Relations
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("InviteCodeCreator", fields: [createdById], references: [id])
  
  @@index([code])
  @@index([companyId])
  @@index([isActive])
  @@map("invite_codes")
}

// =============================================
// Enums
// =============================================

// User roles for authorization and RBAC (hierarchical order)
enum UserRole {
  GUEST          // No company access, login only
  EMPLOYEE       // Company member, can chat with executives (needs verification)
  EXECUTIVE      // Higher privilege employee, linked to AI persona
  COMPANY_ADMIN  // Manages company users, can verify/promote employees
  SUPER_ADMIN    // Full system access, manages companies and assigns COMPANY_ADMINs
}

// FirstWeek reads require explicit project membership, including administrators.
model Project {
  id          String
  companyId   String
  name        String
  description String @default("")
  isActive    Boolean @default(true)
  hasCuratedKnowledge Boolean @default(true)
  knowledgeVersion Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  responsibilities ProjectResponsibility[]
  documents   ProjectDocument[]
  readingSteps ProjectReadingStep[]

  @@id([companyId, id])
  @@map("projects")
}

model ProjectDocument {
  companyId  String
  projectId  String
  id         String
  title      String
  filename   String
  mediaType  String
  content    String
  sha256     String
  byteSize   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Cascade)
  chunks     ProjectDocumentChunk[]
  readingSteps ProjectReadingStep[]

  @@id([companyId, projectId, id])
  @@index([companyId, projectId, createdAt])
  @@map("project_documents")
}

model ProjectDocumentChunk {
  companyId  String
  projectId  String
  documentId String
  position   Int
  heading    String
  content    String
  document   ProjectDocument @relation(fields: [companyId, projectId, documentId], references: [companyId, projectId, id], onDelete: Cascade)

  @@id([companyId, projectId, documentId, position])
  @@map("project_document_chunks")
}

model ProjectMember {
  companyId String
  projectId String
  userId    String
  role      String @default("MEMBER")
  onboardingRole String?
  onboardingExperience String?
  profileVersion Int @default(0)
  createdAt DateTime @default(now())
  project   Project @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Cascade)
  user      User @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Cascade)
  responsibilityAssignments ResponsibilityAssignment[]
  conversations ProjectConversation[]
  readingProgress ProjectReadingProgress[]

  @@id([companyId, projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectConversation {
  companyId String
  projectId String
  userId String
  id String
  title String @default("New conversation")
  turns Json @default("[]")
  knowledgeHash String
  version Int @default(0)
  pendingId String?
  pendingQuestion String?
  pendingAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member ProjectMember @relation(fields: [companyId, projectId, userId], references: [companyId, projectId, userId], onDelete: Cascade)

  @@id([companyId, projectId, userId, id])
  @@map("project_conversations")
}

// Maintainer-authored steps reference managed project documents. A completion belongs
// to one exact project member and never grants access or represents an ownership claim.
model ProjectReadingStep {
  companyId String
  projectId String
  id String
  title String
  description String @default("")
  documentId String
  focus String?
  experience String?
  position Int
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Cascade)
  document ProjectDocument @relation(fields: [companyId, projectId, documentId], references: [companyId, projectId, id], onDelete: Cascade)
  progress ProjectReadingProgress[]

  @@id([companyId, projectId, id])
  @@unique([companyId, projectId, position])
  @@index([companyId, projectId, documentId])
  @@map("project_reading_steps")
}

model ProjectReadingProgress {
  companyId String
  projectId String
  stepId String
  userId String
  stepRevision Int
  completedAt DateTime @default(now())
  member ProjectMember @relation(fields: [companyId, projectId, userId], references: [companyId, projectId, userId], onDelete: Cascade)
  step ProjectReadingStep @relation(fields: [companyId, projectId, stepId], references: [companyId, projectId, id], onDelete: Cascade)

  @@id([companyId, projectId, stepId, userId])
  @@index([companyId, projectId, userId])
  @@map("project_reading_progress")
}

model ProjectResponsibility {
  companyId  String
  projectId  String
  id         String
  name       String
  description String @default("")
  status     String @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Cascade)
  assignment ResponsibilityAssignment?

  @@id([companyId, projectId, id])
  @@map("project_responsibilities")
}

model ResponsibilityAssignment {
  companyId       String
  projectId       String
  responsibilityId String
  ownerUserId     String
  responsibility ProjectResponsibility @relation(fields: [companyId, projectId, responsibilityId], references: [companyId, projectId, id], onDelete: Cascade)
  owner           ProjectMember @relation(fields: [companyId, projectId, ownerUserId], references: [companyId, projectId, userId], onDelete: Cascade)

  @@id([companyId, projectId, responsibilityId])
  @@index([companyId, projectId, ownerUserId])
  @@map("responsibility_assignments")
}
