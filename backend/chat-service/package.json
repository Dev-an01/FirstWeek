{
  "name": "chat-service",
  "version": "1.0.0",
  "description": "chat service for FirstWeek",
  "license": "ISC",
  "author": "firstweek-team",
  "type": "commonjs",
  "main": "server.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "dev": "nodemon",
    "start": "node server.js",
    "generate": "npm run generate:chat && npm run generate:auth",
    "generate:chat": "prisma generate --schema=./shared/prisma/schema.prisma",
    "generate:auth": "prisma generate --schema=./shared/prisma/auth.schema.prisma",
    "db:push": "prisma db push --schema=./shared/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./shared/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./shared/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema=./shared/prisma/schema.prisma --force"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "axios": "^1.7.9",
    "colors": "^1.4.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^6.9.0",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "yamljs": "^0.3.0",
    "zod": "^3.25.62",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
