# Recall Service Configuration
PORT=3003
NODE_ENV=development

# Recall.ai API
RECALL_API_KEY=your_recall_api_key_here
RECALL_API_URL=https://api.recall.ai/api/v1
RECALL_BOT_NAME=firstweek Assistant

# Avatar Interface URL (must be publicly accessible)
AVATAR_INTERFACE_URL=https://your-domain.com/avatar
# For local development with ngrok:
# AVATAR_INTERFACE_URL=https://abc123.ngrok.io

# RAG API
RAG_API_URL=http://rag-api:8000

# Default Executive Profile
DEFAULT_PROFILE_ID=exec_001_test

# Logging
LOG_LEVEL=info
